{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.panda-blog.com"
        }
      ],
      "destination": "https://panda-blog.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.panda-blog.com"
        }
      ],
      "destination": "https://panda-blog.com/:path*",
      "permanent": true
    }
  ]
}
