---
import dict from '../i18n/dict.js';

const { lang = 'zh' } = Astro.props;
const t = dict[lang] || dict.zh;
---

<div>
  <div class="text-center py-8">
    <div class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-5" style="background-color: var(--primary-light);">
      <svg class="w-6 h-6" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
      </svg>
    </div>
    <h3 class="text-lg font-medium font-serif mb-3" style="color: var(--text);">{t['donate.title']}</h3>
    <p class="text-sm mb-6 max-w-xs mx-auto" style="color: var(--text-secondary);">{t['donate.desc']}</p>
    <button id="donate-trigger" class="btn-primary">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
      </svg>
      {t['donate.btn']}
    </button>
  </div>

  <dialog id="donate-dialog" class="rounded-2xl p-0 bg-transparent backdrop:bg-black/30 border-0">
    <div class="rounded-2xl p-8 max-w-sm w-full mx-4 border shadow-xl" style="background-color: var(--surface); border-color: var(--border);">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h3 class="text-xl font-medium font-serif" style="color: var(--text);">{t['donate.dialogTitle']}</h3>
          <p class="text-sm mt-1" style="color: var(--text-muted);">{t['donate.dialogDesc']}</p>
        </div>
        <button onclick="document.getElementById('donate-dialog').close()" class="p-2 rounded-lg transition-colors" style="color: var(--text-muted);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="text-center">
          <div class="aspect-square rounded-xl border flex items-center justify-center mb-3 overflow-hidden" style="background-color: var(--bg); border-color: var(--border);">
            <img src="/wechat-qr.png" alt={t['donate.wechat']} class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
            <span class="hidden text-sm" style="color: var(--text-muted);">{t['donate.qrPlaceholder']}</span>
          </div>
          <span class="text-sm" style="color: var(--text-secondary);">{t['donate.wechat']}</span>
        </div>
        <div class="text-center">
          <div class="aspect-square rounded-xl border flex items-center justify-center mb-3 overflow-hidden" style="background-color: var(--bg); border-color: var(--border);">
            <img src="/alipay-qr.png" alt={t['donate.alipay']} class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
            <span class="hidden text-sm" style="color: var(--text-muted);">{t['donate.qrPlaceholder']}</span>
          </div>
          <span class="text-sm" style="color: var(--text-secondary);">{t['donate.alipay']}</span>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const trigger = document.getElementById('donate-trigger');
  const dialog = document.getElementById('donate-dialog');
  trigger?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
