---
---

<div class="mt-12 pt-8 border-t border-stone-200 dark:border-stone-800">
  <div class="text-center">
    <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">
      如果这篇文章对你有帮助，欢迎打赏支持
    </p>
    
    <button
      id="donate-trigger"
      class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary-500 hover:bg-primary-600 text-white text-sm font-medium transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      赞赏支持
    </button>
  </div>
  
  <dialog id="donate-dialog" class="rounded-xl p-0 bg-transparent backdrop:bg-black/50">
    <div class="bg-white dark:bg-stone-900 rounded-xl p-6 max-w-sm w-full mx-4 border border-stone-200 dark:border-stone-700">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100">打赏支持</h3>
        <button onclick="document.getElementById('donate-dialog').close()" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">
        感谢你的支持，这对我来说意义重大！
      </p>
      
      <div class="flex gap-4 justify-center">
        <div class="text-center">
          <div class="w-32 h-32 bg-stone-100 dark:bg-stone-800 rounded-lg flex items-center justify-center mb-2">
            <span class="text-xs text-stone-500">微信支付</span>
          </div>
          <span class="text-xs text-stone-500">微信</span>
        </div>
        <div class="text-center">
          <div class="w-32 h-32 bg-stone-100 dark:bg-stone-800 rounded-lg flex items-center justify-center mb-2">
            <span class="text-xs text-stone-500">支付宝</span>
          </div>
          <span class="text-xs text-stone-500">支付宝</span>
        </div>
      </div>
      
      <p class="text-xs text-stone-400 text-center mt-4">
        请将收款码图片替换到 public 目录
      </p>
    </div>
  </dialog>
</div>

<script>
  const donateTrigger = document.getElementById('donate-trigger');
  const donateDialog = document.getElementById('donate-dialog');
  
  donateTrigger?.addEventListener('click', () => {
    donateDialog?.showModal();
  });
  
  donateDialog?.addEventListener('click', (e) => {
    if (e.target === donateDialog) donateDialog.close();
  });
</script>
