---
---

<div class="mt-16 pt-10 border-t border-slate-100 dark:border-slate-800/60">
  <div class="flex flex-col items-center text-center">
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary-50 to-accent-50 dark:from-primary-900/20 dark:to-accent-900/20 flex items-center justify-center mb-4">
      <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
      </svg>
    </div>
    <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">喜欢这篇文章？</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-5 max-w-sm">
      如果它对你有所帮助，可以考虑支持我，让我继续创作更多优质内容
    </p>

    <button
      id="donate-trigger"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-primary-500 to-accent-500 hover:from-primary-600 hover:to-accent-600 text-white text-sm font-medium shadow-lg shadow-primary-500/25 hover:shadow-xl hover:shadow-primary-500/30 transition-all hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
      </svg>
      赞赏支持
    </button>
  </div>

  <dialog id="donate-dialog" class="rounded-2xl p-0 bg-transparent backdrop:bg-black/40 backdrop-blur-sm border-0">
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-8 max-w-sm w-full mx-4 border border-slate-100 dark:border-slate-700 shadow-2xl">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">打赏支持</h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">感谢您的慷慨</p>
        </div>
        <button onclick="document.getElementById('donate-dialog').close()" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <p class="text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
        每一份支持都是我继续创作的动力，谢谢你！
      </p>

      <div class="grid grid-cols-2 gap-4">
        <div class="text-center">
          <div class="aspect-square rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 flex items-center justify-center mb-2.5 overflow-hidden">
            <img
              src="/wechat-qr.png"
              alt="微信支付"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <span class="hidden text-xs text-slate-400">微信收款码</span>
          </div>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">微信支付</span>
        </div>
        <div class="text-center">
          <div class="aspect-square rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 flex items-center justify-center mb-2.5 overflow-hidden">
            <img
              src="/alipay-qr.png"
              alt="支付宝"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <span class="hidden text-xs text-slate-400">支付宝收款码</span>
          </div>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">支付宝</span>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const donateTrigger = document.getElementById('donate-trigger');
  const donateDialog = document.getElementById('donate-dialog');

  donateTrigger?.addEventListener('click', () => {
    donateDialog?.showModal();
  });

  donateDialog?.addEventListener('click', (e) => {
    if (e.target === donateDialog) donateDialog.close();
  });
</script>
