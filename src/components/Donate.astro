---
---

<div class="mt-12 pt-8 border-t border-[#e0e0e0] dark:border-[#333333]">
  <div class="text-center">
    <div class="w-10 h-10 rounded-full bg-[#e3f2fd] dark:bg-[rgba(33,150,243,0.15)] flex items-center justify-center mx-auto mb-4">
      <svg class="w-5 h-5 text-[#2196f3] dark:text-[#64b5f6]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
      </svg>
    </div>
    <h3 class="text-base font-semibold text-[#212121] dark:text-[#f5f5f5] mb-2">喜欢这篇文章？</h3>
    <p class="text-sm text-[#757575] dark:text-[#9e9e9e] mb-5">如果对你有所帮助，欢迎支持我继续创作</p>
    <button
      id="donate-trigger"
      class="material-btn material-btn-primary"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
      </svg>
      赞赏支持
    </button>
  </div>

  <dialog id="donate-dialog" class="rounded-2xl p-0 bg-transparent backdrop:bg-black/30 border-0">
    <div class="bg-white dark:bg-[#1e1e1e] rounded-2xl p-6 max-w-sm w-full mx-4 border border-[#e0e0e0] dark:border-[#333333] shadow-xl">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h3 class="text-lg font-semibold text-[#212121] dark:text-[#f5f5f5]">打赏支持</h3>
          <p class="text-xs text-[#9e9e9e] mt-0.5">感谢您的慷慨</p>
        </div>
        <button onclick="document.getElementById('donate-dialog').close()" class="p-1.5 rounded-lg text-[#9e9e9e] hover:text-[#616161] dark:hover:text-[#bdbdbd] hover:bg-[#f5f5f5] dark:hover:bg-[#2d2d2d] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="text-center">
          <div class="aspect-square rounded-xl bg-[#f5f5f5] dark:bg-[#2d2d2d] border border-[#e0e0e0] dark:border-[#333333] flex items-center justify-center mb-2 overflow-hidden">
            <img src="/wechat-qr.png" alt="微信支付" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
            <span class="hidden text-xs text-[#9e9e9e]">微信收款码</span>
          </div>
          <span class="text-xs text-[#757575] dark:text-[#9e9e9e]">微信支付</span>
        </div>
        <div class="text-center">
          <div class="aspect-square rounded-xl bg-[#f5f5f5] dark:bg-[#2d2d2d] border border-[#e0e0e0] dark:border-[#333333] flex items-center justify-center mb-2 overflow-hidden">
            <img src="/alipay-qr.png" alt="支付宝" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
            <span class="hidden text-xs text-[#9e9e9e]">支付宝收款码</span>
          </div>
          <span class="text-xs text-[#757575] dark:text-[#9e9e9e]">支付宝</span>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const trigger = document.getElementById('donate-trigger');
  const dialog = document.getElementById('donate-dialog');
  trigger?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
