---
const languages = [
  { code: 'zh', label: '中文' },
  { code: 'en', label: 'EN' },
  { code: 'ja', label: '日本語' },
];
---

<div id="lang-switcher" class="lang-switcher">
  {languages.map((lang) => (
    <button
      class="lang-btn"
      data-lang={lang.code}
    >
      {lang.label}
    </button>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.125rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1.5px solid rgba(0, 0, 0, 0.22);
  }

  [data-theme="dark"] .lang-switcher {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .lang-btn {
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
    color: rgba(0, 0, 0, 0.62);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  [data-theme="dark"] .lang-btn {
    color: rgba(255, 253, 245, 0.62);
  }

  .lang-btn.active {
    background-color: #81aed9;
    color: #000000;
    font-weight: 600;
  }

  [data-theme="dark"] .lang-btn.active {
    color: #000000;
  }
</style>

<script>
  function initLangSwitcher() {
    const buttons = document.querySelectorAll('#lang-switcher .lang-btn');
    if (!buttons.length) return;

    function updateActive() {
      const lang = localStorage.getItem('lang') || 'zh';
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-lang') === lang;
        btn.classList.toggle('active', isActive);
      });
    }

    updateActive();

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang');
        if (!targetLang) return;
        localStorage.setItem('lang', targetLang);
        updateActive();

        const url = new URL(window.location.href);
        let cleanPath = url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '');
        if (!cleanPath || cleanPath === '') cleanPath = '/';

        if (targetLang === 'zh') {
          url.pathname = cleanPath;
        } else {
          url.pathname = '/' + targetLang + cleanPath;
        }

        window.location.href = url.toString();
      });
    });
  }

  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
