---
const languages = [
  { code: 'zh', label: '中文', shortLabel: '中' },
  { code: 'en', label: 'EN', shortLabel: 'EN' },
  { code: 'ja', label: '日本語', shortLabel: '日' },
];
---

<div id="lang-switcher" class="lang-switcher">
  {languages.map((lang) => (
    <button
      class="lang-btn"
      data-lang={lang.code}
    >
      <span class="lang-label-full">{lang.label}</span>
      <span class="lang-label-short">{lang.shortLabel}</span>
    </button>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.125rem;
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.68);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 10px 24px rgba(52, 70, 100, 0.07);
    backdrop-filter: blur(18px) saturate(1.26);
    -webkit-backdrop-filter: blur(18px) saturate(1.26);
  }

  [data-theme="dark"] .lang-switcher {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .lang-btn {
    min-width: 2.35rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: transform 0.22s ease, color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
    color: rgba(31, 42, 61, 0.62);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .lang-btn:hover {
    color: #1f2a3d;
    background: rgba(255, 255, 255, 0.32);
  }

  .lang-btn:active {
    transform: scale(0.96);
  }

  .lang-label-short {
    display: none;
  }

  [data-theme="dark"] .lang-btn {
    color: rgba(255, 253, 245, 0.62);
  }

  [data-theme="dark"] .lang-btn:hover {
    color: #fffdf5;
    background: rgba(255, 255, 255, 0.08);
  }

  .lang-btn.active {
    background:
      linear-gradient(180deg, rgba(219, 231, 251, 0.84), rgba(219, 231, 251, 0.58)),
      rgba(255, 255, 255, 0.22);
    color: #1f2a3d;
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      0 8px 18px rgba(82, 111, 164, 0.12);
  }

  [data-theme="dark"] .lang-btn.active {
    color: #fffdf5;
    background: linear-gradient(180deg, rgba(129, 174, 217, 0.28), rgba(129, 174, 217, 0.16));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 18px rgba(0, 0, 0, 0.16);
  }

  @media (max-width: 639px) {
    .lang-switcher {
      gap: 0;
      padding: 0.08rem;
      border-radius: 0.42rem;
    }

    .lang-btn {
      min-width: 1.45rem;
      padding: 0.24rem 0.25rem;
      border-radius: 0.32rem;
      font-size: 0.62rem;
    }

    .lang-label-full {
      display: none;
    }

    .lang-label-short {
      display: inline;
    }
  }
</style>

<script>
  function initLangSwitcher() {
    const buttons = document.querySelectorAll('#lang-switcher .lang-btn');
    if (!buttons.length) return;

    function getCurrentLang() {
      const path = window.location.pathname;
      if (path.startsWith('/en')) return 'en';
      if (path.startsWith('/ja')) return 'ja';
      return 'zh';
    }

    function updateActive() {
      const lang = getCurrentLang();
      localStorage.setItem('lang', lang); // 保持 localStorage 与 URL 同步
      buttons.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });
    }

    updateActive();

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang');
        if (!targetLang) return;
        localStorage.setItem('lang', targetLang);
        updateActive();

        const url = new URL(window.location.href);
        let cleanPath = url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '');
        if (!cleanPath || cleanPath === '') cleanPath = '/';

        if (targetLang === 'zh') {
          url.pathname = cleanPath;
        } else {
          url.pathname = '/' + targetLang + cleanPath;
        }

        window.location.href = url.toString();
      });
    });
  }

  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
