---
const languages = [
  { code: 'zh', label: '中文' },
  { code: 'en', label: 'EN' },
  { code: 'ja', label: '日本語' },
];
---

<div id="lang-switcher" class="flex items-center gap-0.5 p-0.5 rounded-lg" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);">
  {languages.map((lang) => (
    <button
      class="lang-btn px-2.5 py-1.5 rounded-md text-xs font-medium transition-all duration-200"
      data-lang={lang.code}
      style="color: rgba(255,255,255,0.65);"
    >
      {lang.label}
    </button>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll('.lang-btn');

  function updateActive() {
    const lang = localStorage.getItem('lang') || 'zh';
    buttons.forEach((btn) => {
      const isActive = btn.getAttribute('data-lang') === lang;
      if (isActive) {
        btn.style.backgroundColor = '#19E6C1';
        btn.style.color = '#002C24';
        btn.style.fontWeight = '600';
        btn.style.boxShadow = '0 2px 8px rgba(25,230,193,0.3)';
      } else {
        btn.style.backgroundColor = 'transparent';
        btn.style.color = 'rgba(255,255,255,0.65)';
        btn.style.fontWeight = '500';
        btn.style.boxShadow = 'none';
      }
    });
  }

  updateActive();

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetLang = btn.getAttribute('data-lang');
      localStorage.setItem('lang', targetLang);
      updateActive();

      const url = new URL(window.location.href);
      let cleanPath = url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '');
      if (!cleanPath || cleanPath === '') cleanPath = '/';

      if (targetLang === 'zh') {
        url.pathname = cleanPath;
      } else {
        url.pathname = '/' + targetLang + cleanPath;
      }

      window.location.href = url.toString();
    });
  });
</script>
