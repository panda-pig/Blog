---
const languages = [
  { code: 'zh', label: '中文' },
  { code: 'en', label: 'EN' },
  { code: 'ja', label: '日本語' },
];
---

<div id="lang-switcher" class="lang-switcher">
  {languages.map((lang) => (
    <button
      class="lang-btn"
      data-lang={lang.code}
    >
      {lang.label}
    </button>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.125rem;
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.66);
    border: 1px solid rgba(31, 42, 61, 0.12);
    box-shadow: 0 10px 24px rgba(52, 70, 100, 0.08);
  }

  [data-theme="dark"] .lang-switcher {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .lang-btn {
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
    color: rgba(31, 42, 61, 0.62);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  [data-theme="dark"] .lang-btn {
    color: rgba(255, 253, 245, 0.62);
  }

  .lang-btn.active {
    background-color: #dbe7fb;
    color: #1f2a3d;
    font-weight: 600;
    box-shadow: 0 8px 18px rgba(82, 111, 164, 0.14);
  }

  [data-theme="dark"] .lang-btn.active {
    color: #000000;
  }
</style>

<script>
  function initLangSwitcher() {
    const buttons = document.querySelectorAll('#lang-switcher .lang-btn');
    if (!buttons.length) return;

    function getCurrentLang() {
      const path = window.location.pathname;
      if (path.startsWith('/en')) return 'en';
      if (path.startsWith('/ja')) return 'ja';
      return 'zh';
    }

    function updateActive() {
      const lang = getCurrentLang();
      localStorage.setItem('lang', lang); // 保持 localStorage 与 URL 同步
      buttons.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });
    }

    updateActive();

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang');
        if (!targetLang) return;
        localStorage.setItem('lang', targetLang);
        updateActive();

        const url = new URL(window.location.href);
        let cleanPath = url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '');
        if (!cleanPath || cleanPath === '') cleanPath = '/';

        if (targetLang === 'zh') {
          url.pathname = cleanPath;
        } else {
          url.pathname = '/' + targetLang + cleanPath;
        }

        window.location.href = url.toString();
      });
    });
  }

  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
