---
const languages = [
  { code: 'zh', label: '中' },
  { code: 'en', label: '英' },
  { code: 'ja', label: '日' },
];
---

<div id="lang-switcher" class="flex items-center gap-0.5 p-0.5 rounded-lg" style="background-color: var(--surface); border: 1px solid var(--border);">
  {languages.map((lang) => (
    <button
      class="lang-btn px-2 py-1 rounded-md text-[11px] font-medium transition-all"
      data-lang={lang.code}
      style="color: var(--text-secondary);"
    >
      {lang.label}
    </button>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll('.lang-btn');

  function updateActive() {
    const lang = localStorage.getItem('lang') || 'zh';
    buttons.forEach((btn) => {
      const isActive = btn.getAttribute('data-lang') === lang;
      if (isActive) {
        btn.style.backgroundColor = 'var(--primary)';
        btn.style.color = '#fff';
      } else {
        btn.style.backgroundColor = 'transparent';
        btn.style.color = 'var(--text-secondary)';
      }
    });
  }

  updateActive();

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      localStorage.setItem('lang', lang);
      updateActive();
      window.location.reload();
    });
  });
</script>
