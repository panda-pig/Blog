---
import DarkModeToggle from './DarkModeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/blog', label: '文章', icon: 'blog' },
  { href: '/projects', label: '项目', icon: 'projects' },
  { href: '/about', label: '关于', icon: 'about' },
  { href: '/contact', label: '联系', icon: 'contact' },
  { href: 'https://github.com/panda-pig', label: 'GitHub', icon: 'github', external: true },
];
---

<aside class="hidden md:block min-w-64 rounded-l-md" style="background-color: var(--side-bg);">
  <!-- Logo & Name -->
  <div class="mb-5 flex items-center justify-between px-8">
    <a href="/" class="flex flex-row items-center justify-start py-4 group">
      <div class="mr-4 h-10 w-10 rounded-full flex items-center justify-center text-white text-sm font-bold" style="background-color: var(--primary);">
        P
      </div>
      <h1 class="text-lg font-bold" style="color: var(--title);">Panda Lab</h1>
    </a>
    <DarkModeToggle />
  </div>

  <!-- Navigation -->
  <nav>
    <ul class="mb-5 border-b px-8 py-0 pb-5" style="border-color: var(--side-border);">
      {navItems.map((item) => {
        const isActive = item.external ? false : (item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class={`nav-item ${isActive ? 'active' : ''}`}
            >
              {item.icon === 'home' && (
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              )}
              {item.icon === 'blog' && (
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              )}
              {item.icon === 'projects' && (
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {item.icon === 'about' && (
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              )}
              {item.icon === 'contact' && (
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {item.icon === 'github' && (
                <svg class="w-4 h-4 mr-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- About Section -->
  <div class="px-8">
    <p class="mb-4 text-sm" style="color: var(--text-secondary);">
      记录技术学习，分享项目实践，把想法快速变成产品。
    </p>
    <div class="mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2" style="color: var(--side-about-icon);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="text-sm" style="color: var(--side-about-text);">中国</span>
    </div>
    <div class="mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2" style="color: var(--side-about-icon);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
      </svg>
      <span class="text-sm" style="color: var(--side-about-text);">Web 开发 & AI 应用</span>
    </div>
    <div class="mb-2 flex items-center">
      <svg class="w-4 h-4 mr-2" style="color: var(--side-about-icon);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M13.828 1.172a4 4 0 015.656 5.656l-9.984 9.984a2 2 0 01-1.414.586H7.414l-2.828-2.828a2 2 0 01-.586-1.414V9.984a2 2 0 01.586-1.414l9.984-9.984z"/>
        <path d="M14.121 3.707a1 1 0 011.414 0l.172.172a1 1 0 010 1.414l-7.07 7.071a1 1 0 01-1.415 0l-.172-.172a1 1 0 010-1.414l7.07-7.071z"/>
      </svg>
      <span class="text-sm" style="color: var(--side-about-text);">Astro + Tailwind</span>
    </div>
  </div>
</aside>
