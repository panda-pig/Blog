---
import dict from '../i18n/dict.js';

const { slug, lang = 'zh' } = Astro.props;
const t = dict[lang] || dict.zh;
const giscusLang = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja' : 'en';
---

<div class="mt-0">
  <div class="flex items-center gap-4 mb-8">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background-color: var(--primary-light);">
      <svg class="w-5 h-5" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
    </div>
    <h3 class="text-xl font-medium font-serif" style="color: var(--text);">{t['article.comments']}</h3>
  </div>
  <div class="rounded-2xl border p-2" style="background-color: var(--surface); border-color: var(--border);">
    <div class="rounded-xl overflow-hidden giscus-container" data-giscus-lang={giscusLang}></div>
  </div>
</div>

<script>
  let giscusObserver: MutationObserver | null = null;

  function getSiteGiscusTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function updateGiscusTheme() {
    const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement | null;
    if (!iframe) return;
    iframe.contentWindow?.postMessage({ giscus: { setConfig: { theme: getSiteGiscusTheme() } } }, 'https://giscus.app');
  }

  function initGiscus() {
    const container = document.querySelector('.giscus-container') as HTMLElement | null;
    if (!container) return;

    if (container.querySelector('script')) return;

    const theme = getSiteGiscusTheme();
    const lang = container.dataset.giscusLang || 'zh-CN';

    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.dataset.repo = 'panda-pig/Blog';
    s.dataset.repoId = 'R_kgDOSdLFcA';
    s.dataset.category = 'Blog Comments';
    s.dataset.categoryId = 'DIC_kwDOSdLFcM4C9BwJ';
    s.dataset.mapping = 'pathname';
    s.dataset.strict = '0';
    s.dataset.reactionsEnabled = '1';
    s.dataset.emitMetadata = '0';
    s.dataset.inputPosition = 'top';
    s.dataset.theme = theme;
    s.dataset.lang = lang;
    s.dataset.loading = 'lazy';
    s.crossOrigin = 'anonymous';
    s.async = true;

    s.addEventListener('load', () => {
      window.setTimeout(updateGiscusTheme, 300);
    });

    container.appendChild(s);

    if (giscusObserver) giscusObserver.disconnect();
    giscusObserver = new MutationObserver((mutations) => {
      mutations.forEach((m) => { if (m.attributeName === 'data-theme') updateGiscusTheme(); });
    });
    giscusObserver.observe(document.documentElement, { attributes: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGiscus, { once: true });
  } else {
    initGiscus();
  }

  document.addEventListener('astro:page-load', initGiscus);
</script>
