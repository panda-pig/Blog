---
const { slug } = Astro.props;
---

<div class="mt-12 pt-8 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="flex items-center gap-3 mb-6">
    <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/30 flex items-center justify-center">
      <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
    </div>
    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200">评论</h3>
  </div>
  <div class="bg-white dark:bg-slate-900/50 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 p-1">
    <div class="rounded-xl overflow-hidden">
      <script
        src="https://giscus.app/client.js"
        data-repo="panda-pig/Blog"
        data-repo-id="R_kgD0SdLFcA"
        data-category="Blog Comments"
        data-category-id="DIC_kwD0SdLFcM4C9BwJ"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </div>
</div>

<script>
  function updateGiscusTheme() {
    const iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;
    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    iframe.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  }
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((m) => { if (m.attributeName === 'class') updateGiscusTheme(); });
  });
  observer.observe(document.documentElement, { attributes: true });
</script>
