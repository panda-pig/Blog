---
---

<div class="relative">
  <button
    id="search-trigger"
    class="w-full max-w-lg mx-auto flex items-center gap-3 px-5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:border-slate-300 dark:hover:border-slate-600 transition-all text-sm group"
    onclick="document.getElementById('search-dialog').showModal()"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <span class="flex-1 text-left">搜索文章...</span>
    <kbd class="px-2 py-1 text-[11px] font-mono bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-md text-slate-400">Ctrl K</kbd>
  </button>
</div>

<dialog id="search-dialog" class="fixed inset-0 w-full h-full bg-black/30 backdrop-blur-md p-0 m-0 border-0">
  <div class="absolute top-[15%] left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
      <div id="search-container" class="p-2 min-h-[320px]"></div>
    </div>
  </div>
</dialog>

<script>
  import { PagefindUI } from '@pagefind/default-ui';

  const dialog = document.getElementById('search-dialog');

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      dialog?.showModal();
    }
    if (e.key === 'Escape') {
      dialog?.close();
    }
  });

  const container = document.getElementById('search-container');
  if (container && !container.dataset.initialized) {
    new PagefindUI({
      element: '#search-container',
      showImages: false,
      showSubResults: true,
      translations: {
        placeholder: '搜索文章...',
        clear_search: '清除',
        load_more: '加载更多',
        search_label: '搜索',
        zero_results: '没有找到相关文章',
        many_results: '[COUNT] 篇相关文章',
        one_result: '1 篇相关文章',
        alt_search: '没有找到相关文章，显示所有结果',
      },
    });
    container.dataset.initialized = 'true';
  }
</script>

<style>
  dialog::backdrop { display: none; }
  dialog[open] { display: flex; align-items: flex-start; justify-content: center; padding-top: 10vh; }
</style>
