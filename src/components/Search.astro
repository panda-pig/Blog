---
---

<div class="relative">
  <button
    id="search-trigger"
    class="w-full max-w-md mx-auto flex items-center gap-2 px-4 py-2.5 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors text-sm"
    onclick="document.getElementById('search-dialog').showModal()"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <span>搜索文章...</span>
    <kbd class="ml-auto px-1.5 py-0.5 text-xs bg-stone-200 dark:bg-stone-700 rounded">Ctrl K</kbd>
  </button>
</div>

<dialog id="search-dialog" class="fixed inset-0 w-full h-full bg-black/50 backdrop-blur-sm p-0 m-0">
  <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-full max-w-2xl px-4">
    <div class="bg-white dark:bg-stone-900 rounded-xl shadow-2xl border border-stone-200 dark:border-stone-700 overflow-hidden">
      <div id="search-container" class="p-4 min-h-[300px]"></div>
    </div>
  </div>
</dialog>

<script>
  import { PagefindUI } from '@pagefind/default-ui';
  
  const dialog = document.getElementById('search-dialog');
  
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      dialog?.showModal();
    }
    if (e.key === 'Escape') {
      dialog?.close();
    }
  });
  
  const container = document.getElementById('search-container');
  if (container && !container.dataset.initialized) {
    new PagefindUI({
      element: '#search-container',
      showImages: false,
      showSubResults: true,
      translations: {
        placeholder: '搜索文章...',
        clear_search: '清除',
        load_more: '加载更多',
        search_label: '搜索',
        zero_results: '没有找到相关文章',
        many_results: '[COUNT] 篇相关文章',
        one_result: '1 篇相关文章',
        alt_search: '没有找到相关文章，显示所有结果',
      },
    });
    container.dataset.initialized = 'true';
  }
</script>

<style>
  dialog::backdrop {
    display: none;
  }
  dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
