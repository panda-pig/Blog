---
import dict from '../i18n/dict.js';

const { lang = 'zh' } = Astro.props;
const t = dict[lang] || dict.zh;
---

<div id="search-wrapper" class="relative">
  <div class="flex items-center gap-3 px-4 py-2.5 rounded-lg border text-sm transition-all" style="background-color: var(--surface); border-color: var(--border);">
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--text-muted);">
      <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      id="search-input"
      type="text"
      class="flex-1 bg-transparent border-none outline-none text-sm"
      style="color: var(--text);"
      placeholder={t['search.placeholder']}
      autocomplete="off"
    />
  </div>
  <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 rounded-xl border overflow-hidden z-50" style="background-color: var(--surface); border-color: var(--border); box-shadow: 0 8px 32px rgba(0,0,0,0.12);">
    <div id="search-results-inner" class="max-h-80 overflow-y-auto p-2"></div>
  </div>
</div>

<script is:inline>
  (function() {
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var inner = document.getElementById('search-results-inner');
    var lang = localStorage.getItem('lang') || 'zh';
    var timer;

    var labels = {
      zh: { noResults: '没有找到相关文章', readingTime: '分钟阅读' },
      en: { noResults: 'No results found', readingTime: 'min read' },
      ja: { noResults: '該当する記事が見つかりませんでした', readingTime: '分で読める' },
    };
    var t = labels[lang] || labels.zh;

    input?.addEventListener('input', function() {
      clearTimeout(timer);
      var q = input.value.trim();
      if (!q) { results.classList.add('hidden'); return; }
      timer = setTimeout(function() { search(q); }, 200);
    });

    input?.addEventListener('focus', function() {
      if (inner.children.length > 0) results.classList.remove('hidden');
    });

    document.addEventListener('click', function(e) {
      var wrapper = document.getElementById('search-wrapper');
      if (!wrapper?.contains(e.target)) results.classList.add('hidden');
    });

    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); input?.focus(); }
      if (e.key === 'Escape') results.classList.add('hidden');
    });

    async function search(query) {
      inner.innerHTML = '<div class="px-4 py-8 text-center text-sm" style="color: var(--text-muted);">搜索中...</div>';
      results.classList.remove('hidden');
      try {
        var pagefind = await import('/pagefind/pagefind.js');
        var search = await pagefind.search(query);
        if (!search || !search.results.length) {
          inner.innerHTML = '<div class="px-4 py-8 text-center text-sm" style="color: var(--text-muted);">' + t.noResults + '</div>';
          return;
        }
        var html = '';
        for (var i = 0; i < search.results.length; i++) {
          var data = await search.results[i].data();
          var excerpt = data.excerpt ? data.excerpt.replace(/<[^>]+>/g, '').slice(0, 120) : '';
          var date = data.meta?.date ? new Date(data.meta.date).toLocaleDateString(lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
          var words = data.meta?.words || 0;
          var mins = Math.max(1, Math.ceil(words / 400));
          html += '<a href="' + data.url + '" class="block px-4 py-3 rounded-lg transition-colors hover:opacity-80" style="background: transparent;">' +
            '<div class="text-sm font-semibold mb-1 truncate" style="color: var(--text);">' + (data.meta?.title || '') + '</div>' +
            (excerpt ? '<div class="text-xs mb-1.5 line-clamp-2" style="color: var(--text-secondary);">' + excerpt + '</div>' : '') +
            '<div class="flex items-center gap-2 text-[10px]" style="color: var(--text-muted);">' +
            (date ? '<span>' + date + '</span>' : '') +
            (date && mins ? '<span>·</span>' : '') +
            (mins ? '<span>' + mins + ' ' + t.readingTime + '</span>' : '') +
            '</div></a>';
        }
        inner.innerHTML = html;
      } catch (e) {
        inner.innerHTML = '<div class="px-4 py-8 text-center text-sm" style="color: var(--text-muted);">搜索出错，请重试</div>';
      }
    }
  })();
</script>
