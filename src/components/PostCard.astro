---
interface Props {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  slug: string;
  readingTime?: number;
}

const { title, description, date, tags = [], slug, readingTime = 5 } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="card block p-6 group">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 2).map((tag) => (
        <span class="text-[11px] px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-300 font-medium border border-indigo-100 dark:border-indigo-800/30">
          {tag}
        </span>
      ))}
    </div>
    <span class="text-xs text-slate-400 dark:text-slate-500 font-mono shrink-0">{formattedDate}</span>
  </div>

  <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-200 mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-2">
    {title}
  </h3>

  <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>
    <span>{readingTime} 分钟阅读</span>
  </div>
</a>
