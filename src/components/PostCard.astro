---
interface Props {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  slug: string;
  readingTime?: number;
}

const { title, description, date, tags = [], slug, readingTime = 5 } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="block p-6 rounded-xl border transition-all hover:shadow-lg group" style="background-color: var(--page-bg); border-color: var(--content-border);">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 2).map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
    <span class="text-xs font-mono shrink-0" style="color: var(--text-secondary);">{formattedDate}</span>
  </div>

  <h3 class="text-lg font-semibold mb-2 transition-colors group-hover:opacity-80 line-clamp-2" style="color: var(--title);">
    {title}
  </h3>

  <p class="text-sm line-clamp-2 leading-relaxed mb-4" style="color: var(--text-secondary);">
    {description}
  </p>

  <div class="flex items-center gap-2 text-xs" style="color: var(--text-secondary);">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>
    <span>{readingTime} 分钟阅读</span>
  </div>
</a>
