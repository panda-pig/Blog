---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  status?: string;
}

const { title, description, tags, link = '#', status = '进行中' } = Astro.props;
---

<div class="p-6 flex flex-col h-full rounded-xl border transition-all hover:shadow-lg" style="background-color: var(--page-bg); border-color: var(--content-border);">
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center border" style="background-color: var(--btn-plain-bg); border-color: var(--content-border);">
      <svg class="w-5 h-5" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
    </div>
    <span class={`text-[11px] px-2 py-0.5 rounded-full font-medium border ${status === '已完成' ? '' : ''}`}
      style={status === '已完成' 
        ? 'background-color: rgba(16, 185, 129, 0.1); color: #10b981; border-color: rgba(16, 185, 129, 0.2);'
        : 'background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; border-color: rgba(245, 158, 11, 0.2);'
      }
    >
      {status}
    </span>
  </div>

  <h3 class="text-lg font-semibold mb-2" style="color: var(--title);">{title}</h3>
  <p class="text-sm leading-relaxed mb-4 flex-1" style="color: var(--text-secondary);">{description}</p>

  <div class="flex flex-wrap gap-1.5 mb-4">
    {tags.map((tag) => (
      <span class="text-[11px] px-2 py-0.5 rounded-full border" style="background-color: var(--page-bg); color: var(--text-secondary); border-color: var(--content-border);">
        {tag}
      </span>
    ))}
  </div>

  <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium transition-colors hover:opacity-80" style="color: var(--primary);">
    查看项目
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M7 17L17 7M17 7H7M17 7v10"/>
    </svg>
  </a>
</div>
