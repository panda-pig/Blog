---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  status?: string;
}

const { title, description, tags, link = '#', status = '进行中' } = Astro.props;
---

<div class="card-fluid p-6 flex flex-col h-full">
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: var(--primary-light);">
      <svg class="w-5 h-5" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
    </div>
    <span class="text-[10px] px-2 py-0.5 rounded-full font-medium border uppercase tracking-wider"
      style={status === '已完成' 
        ? 'background-color: var(--badge-bg); color: var(--primary); border-color: var(--primary-light);'
        : 'background-color: var(--accent-warm); color: var(--text-secondary); border-color: var(--border);'
      }
    >
      {status}
    </span>
  </div>

  <h3 class="text-base font-medium mb-2" style="color: var(--text);">{title}</h3>
  <p class="text-xs leading-relaxed mb-4 flex-1" style="color: var(--text-secondary);">{description}</p>

  <div class="flex flex-wrap gap-1.5 mb-4">
    {tags.map((tag) => (
      <span class="tag-pill">{tag}</span>
    ))}
  </div>

  <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider transition-colors hover:opacity-70" style="color: var(--primary);" data-i18n="proj.view">
    查看项目
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M7 17L17 7M17 7H7M17 7v10"/>
    </svg>
  </a>
</div>
