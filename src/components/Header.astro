---
import DarkModeToggle from './DarkModeToggle.astro';
---

<header class="py-6 border-b border-slate-100 dark:border-slate-800">
  <div class="max-w-2xl mx-auto px-6 flex items-center justify-between">
    <a href="/" class="text-base font-medium text-slate-800 dark:text-slate-200 hover:text-slate-500 dark:hover:text-slate-400 transition-colors">
      panda-pig
    </a>
    
    <nav class="flex items-center gap-6 text-sm">
      <a href="/" class="text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
        首页
      </a>
      <a href="/blog" class="text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
        文章
      </a>
      <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
        GitHub
      </a>
      <DarkModeToggle />
    </nav>
  </div>
</header>
