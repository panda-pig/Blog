---
import DarkModeToggle from './DarkModeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const { lang = 'zh' } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: `${prefix}/`, labelKey: 'nav.lab', labelZh: '首页' },
  { href: `${prefix}/blog`, labelKey: 'nav.archive', labelZh: '文章归档' },
  { href: `${prefix}/moments`, labelKey: 'nav.moments', labelZh: '瞬间' },
  { href: `${prefix}/projects`, labelKey: 'nav.experiments', labelZh: '项目' },
  { href: `${prefix}/contact`, labelKey: 'nav.communique', labelZh: '联系' },
];
---

<header style="background: #012620;">
  <div class="section-container flex items-center justify-between h-[72px]">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-sm font-bold" style="background: linear-gradient(135deg, #00f5dc, #7edcaf);">
        <span style="color: #012620;">P</span>
      </div>
      <span class="text-lg font-bold tracking-tight" style="color: #ffffff; font-family: 'DM Sans', sans-serif;">Panda Blog</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`} data-i18n={item.labelKey}>
            {item.labelZh}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <DarkModeToggle />
      <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg transition-colors hover:opacity-70" style="color: rgba(255,255,255,0.7);" aria-label="GitHub">
        <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>
</header>
