---
import DarkModeToggle from './DarkModeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-sm">
  <div class="section-container max-w-3xl">
    <div class="flex items-center justify-between h-14">
      <a href="/" class="text-sm font-semibold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        Panda Lab
      </a>
      
      <nav class="flex items-center gap-5 text-sm">
        <a href="/" class={`transition-colors ${currentPath === '/' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200'}`}>
          Home
        </a>
        <a href="/blog" class={`transition-colors ${currentPath.startsWith('/blog') ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200'}`}>
          Blog
        </a>
        <a href="/projects" class={`transition-colors ${currentPath.startsWith('/projects') ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200'}`}>
          Projects
        </a>
        <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
          GitHub
        </a>
        <DarkModeToggle />
      </nav>
    </div>
  </div>
</header>
