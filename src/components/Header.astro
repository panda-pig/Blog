---
import DarkModeToggle from './DarkModeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import dict from '../i18n/dict.js';

const { lang = 'zh', overlay = false } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
const currentPath = Astro.url.pathname;
const t = dict[lang] || dict.zh;
const instagramUrl = 'https://www.instagram.com/panda_aoo?igsh=b2NkdmNmMm4zOG1j&utm_source=qr';

const navItems = [
  { href: `${prefix}/`, labelKey: 'nav.lab' },
  { href: `${prefix}/blog`, labelKey: 'nav.archive' },
  { href: `${prefix}/moments`, labelKey: 'nav.moments' },
  { href: `${prefix}/projects`, labelKey: 'nav.experiments' },
  { href: `${prefix}/contact`, labelKey: 'nav.communique' },
];
---

<header class={`site-header ${overlay ? 'site-header--overlay' : ''}`} data-pagefind-ignore>
  <div class="section-container flex items-center justify-between h-[72px]">
    <a href={prefix || '/'} class="flex items-center gap-2.5 group shrink-0">
      <div class="w-9 h-9 rounded-xl overflow-hidden flex items-center justify-center logo-mark">
        <img src="/images/avatar.jpg" alt="Panda" class="w-full h-full object-cover" />
      </div>
      <span class="site-logo-text text-lg font-bold tracking-tight logo-text">Panda Blog</span>

    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            {t[item.labelKey]}
          </a>
        );
      })}
    </nav>

    <div class="header-actions flex items-center gap-1">
      <LanguageSwitcher />
      <DarkModeToggle />
      <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex p-2 rounded-lg transition-colors header-icon-btn" aria-label="GitHub">
        <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex p-2 rounded-lg transition-colors header-icon-btn" aria-label="Instagram">
        <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="rounded-lg header-icon-btn" aria-label="菜单" aria-expanded="false">
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="md:hidden hidden mobile-nav-panel">
    <nav class="section-container py-4 flex flex-col gap-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-xl text-sm font-medium transition-colors ${isActive ? 'mobile-nav-active' : 'mobile-nav-link'}`}
          >
            {t[item.labelKey]}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.32)),
      linear-gradient(90deg, rgba(134, 166, 221, 0.16), rgba(255, 255, 255, 0.08) 42%, rgba(255, 133, 98, 0.1));
    border-bottom: 1px solid rgba(255, 255, 255, 0.62);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      0 14px 42px rgba(52, 70, 100, 0.08);
    backdrop-filter: blur(28px) saturate(1.38);
    -webkit-backdrop-filter: blur(28px) saturate(1.38);
  }

  [data-theme="dark"] .site-header {
    background:
      linear-gradient(180deg, rgba(29, 32, 36, 0.62), rgba(29, 32, 36, 0.34)),
      linear-gradient(90deg, rgba(129, 174, 217, 0.12), rgba(255, 255, 255, 0.03) 46%, rgba(255, 133, 98, 0.08));
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 14px 42px rgba(0, 0, 0, 0.2);
  }

  .site-header--overlay {
    position: fixed;
    left: 0;
    width: 100%;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0.2)),
      linear-gradient(90deg, rgba(134, 166, 221, 0.12), rgba(255, 255, 255, 0.05) 44%, rgba(255, 133, 98, 0.08));
    border-bottom-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 14px 42px rgba(52, 70, 100, 0.05);
  }

  [data-theme="dark"] .site-header--overlay {
    background:
      linear-gradient(180deg, rgba(29, 32, 36, 0.48), rgba(29, 32, 36, 0.2)),
      linear-gradient(90deg, rgba(129, 174, 217, 0.1), rgba(255, 255, 255, 0.02) 46%, rgba(255, 133, 98, 0.06));
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 14px 42px rgba(0, 0, 0, 0.16);
  }

  .logo-mark {
    background: rgba(219, 231, 251, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.78),
      0 10px 24px rgba(52, 70, 100, 0.13);
    color: #1f2a3d;
  }

  [data-theme="dark"] .logo-mark {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 10px 24px rgba(0, 0, 0, 0.28);
  }

  .logo-text {
    color: #1f2a3d;
  }

  [data-theme="dark"] .logo-text {
    color: #fffdf5;
  }

  .header-icon-btn {
    border: 1px solid transparent;
    color: rgba(31, 42, 61, 0.72);
    transition: transform 0.22s ease, color 0.22s ease, background 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  #mobile-menu-btn {
    display: none;
  }

  .header-icon-btn:hover {
    color: #1f2a3d;
    background: rgba(255, 255, 255, 0.42);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72), 0 8px 20px rgba(52, 70, 100, 0.1);
    transform: translateY(-1px);
  }

  .header-icon-btn:active {
    transform: translateY(0) scale(0.97);
  }

  [data-theme="dark"] .header-icon-btn {
    color: rgba(255, 253, 245, 0.72);
  }

  [data-theme="dark"] .header-icon-btn:hover {
    color: #fffdf5;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(31, 42, 61, 0.68);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    transition: transform 0.22s ease, color 0.22s ease, background 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    position: relative;
  }

  .nav-link:hover {
    color: #1f2a3d;
    background: rgba(255, 255, 255, 0.34);
    border-color: rgba(255, 255, 255, 0.62);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.68), 0 8px 18px rgba(82, 111, 164, 0.08);
    transform: translateY(-1px);
  }

  [data-theme="dark"] .nav-link {
    color: rgba(255, 253, 245, 0.66);
  }

  [data-theme="dark"] .nav-link:hover {
    color: #fffdf5;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 8px 18px rgba(0, 0, 0, 0.18);
  }

  .nav-link.active {
    color: #1f2a3d;
    background:
      linear-gradient(180deg, rgba(219, 231, 251, 0.82), rgba(219, 231, 251, 0.56)),
      rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.78);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.84),
      inset 0 -1px 0 rgba(82, 111, 164, 0.08),
      0 10px 24px rgba(82, 111, 164, 0.13);
    font-weight: 600;
  }

  [data-theme="dark"] .nav-link.active {
    color: #fffdf5;
    background: linear-gradient(180deg, rgba(129, 174, 217, 0.28), rgba(129, 174, 217, 0.16));
    border-color: rgba(159, 195, 228, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 10px 24px rgba(0, 0, 0, 0.22);
  }

  .mobile-nav-panel {
    background: rgba(255, 255, 255, 0.52);
    border-top: 1px solid rgba(255, 255, 255, 0.62);
    box-shadow: 0 18px 38px rgba(52, 70, 100, 0.1);
    backdrop-filter: blur(26px) saturate(1.28);
    -webkit-backdrop-filter: blur(26px) saturate(1.28);
  }

  [data-theme="dark"] .mobile-nav-panel {
    background: rgba(24, 26, 30, 0.58);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.22);
  }

  .mobile-nav-link {
    color: rgba(31, 42, 61, 0.72);
  }

  [data-theme="dark"] .mobile-nav-link {
    color: rgba(255, 253, 245, 0.72);
  }

  .mobile-nav-active {
    color: #1f2a3d;
    background: rgba(219, 231, 251, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.74);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.78), 0 10px 24px rgba(82, 111, 164, 0.12);
  }

  [data-theme="dark"] .mobile-nav-active {
    color: #fffdf5;
    background: rgba(129, 174, 217, 0.2);
    border-color: rgba(159, 195, 228, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.11), 0 10px 24px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 767px) {
    header .section-container {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
      gap: 0.5rem;
    }

    .site-logo-text {
      display: none;
    }

    .header-actions {
      gap: 0.2rem;
      min-width: 0;
    }

    #mobile-menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 0.85rem;
      right: 0.85rem;
      width: 2.35rem;
      height: 2.35rem;
      padding: 0;
      background: rgba(255, 255, 255, 0.32);
      border: 1px solid rgba(255, 255, 255, 0.68);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72), 0 10px 24px rgba(52, 70, 100, 0.08);
      backdrop-filter: blur(18px) saturate(1.24);
      -webkit-backdrop-filter: blur(18px) saturate(1.24);
    }

    [data-theme="dark"] #mobile-menu-btn {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.14);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 10px 24px rgba(0, 0, 0, 0.18);
    }

    .header-actions :global(.lang-switcher),
    :global(.theme-toggle) {
      display: none;
    }
  }

  @media (max-width: 430px) {
    header .section-container {
      height: 64px;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .logo-mark {
      width: 2rem;
      height: 2rem;
      border-radius: 0.65rem;
    }

    .header-actions {
      gap: 0.1rem;
    }

    #mobile-menu-btn {
      width: 2.15rem;
      height: 2.15rem;
      top: 0.78rem;
      right: 0.75rem;
    }

    #mobile-menu-btn svg {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const panel = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!btn || !panel) return;

    btn.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      if (isOpen) {
        panel.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        panel.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
