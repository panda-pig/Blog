---
const { lang = 'zh' } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
---

<footer style="background: var(--footer-bg); border-top: 2px solid var(--accent-soft);">
  <div class="section-container max-w-5xl py-10 md:py-14">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12 mb-8">
      <!-- Brand -->
      <div class="sm:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-bold" style="background: #81aed9;">
            <span style="color: #fff;">P</span>
          </div>
          <span class="text-lg font-bold" style="color: var(--text);">Panda Blog</span>
        </a>
        <p class="text-sm leading-relaxed mb-4" style="color: var(--text-muted);" data-i18n="footer.tagline">
          一个思想与代码的数字实验室。
        </p>
        <p class="text-xs" style="color: var(--text-muted);" data-i18n="footer.copyright">
          &copy; {new Date().getFullYear()} Panda Blog
        </p>
      </div>

      <!-- Nav links -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--text-muted);" data-i18n="footer.nav">导航</h4>
        <ul class="space-y-1.5">
          <li><a href={`${prefix}/`} class="text-sm transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="nav.lab">首页</a></li>
          <li><a href={`${prefix}/blog`} class="text-sm transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="nav.archive">文章</a></li>
          <li><a href={`${prefix}/moments`} class="text-sm transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="nav.moments">随手记</a></li>
          <li><a href={`${prefix}/projects`} class="text-sm transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="nav.experiments">项目</a></li>
          <li><a href={`${prefix}/contact`} class="text-sm transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="nav.communique">关于</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--text-muted);" data-i18n="footer.connect">联系</h4>
        <ul class="space-y-1.5">
          <li>
            <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="text-sm transition-colors hover:opacity-70 flex items-center gap-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm transition-colors hover:opacity-70 flex items-center gap-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1"/></svg>
              RSS
            </a>
          </li>
          <li>
            <a href="mailto:contact@example.com" class="text-sm transition-colors hover:opacity-70 flex items-center gap-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t flex items-center justify-between gap-4" style="border-color: var(--border);">
      <div class="flex items-center gap-2 text-xs" style="color: var(--text-muted);">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span id="view-counter">加载中...</span>
      </div>
      <p class="text-xs" style="color: var(--text-muted);" data-i18n="footer.dev">由 panda 开发</p>
    </div>
  </div>
</footer>

<script is:inline>
  (function() {
    var counterEl = document.getElementById('view-counter');
    if (!counterEl) return;
    fetch('https://api.countapi.xyz/hit/panda-lab-blog/visits')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        counterEl.textContent = '浏览次数 ' + data.value.toLocaleString();
      })
      .catch(function() {
        counterEl.textContent = '浏览次数 ∞';
      });
  })();
</script>
