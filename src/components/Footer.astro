---
---

<footer class="mt-auto border-t py-12" style="border-color: var(--content-border); background-color: var(--content-bg);">
  <div class="section-container max-w-5xl">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-sm font-bold" style="background-color: var(--primary);">
            P
          </div>
          <span class="text-base font-bold" style="color: var(--title);">Panda Lab</span>
        </a>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
          记录技术学习，分享项目实践，把想法快速变成产品。
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4" style="color: var(--title);">导航</h4>
        <ul class="space-y-2.5">
          <li><a href="/" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">Home</a></li>
          <li><a href="/blog" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">Blog</a></li>
          <li><a href="/projects" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">Projects</a></li>
          <li><a href="/about" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">About</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4" style="color: var(--title);">资源</h4>
        <ul class="space-y-2.5">
          <li><a href="/rss.xml" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">RSS 订阅</a></li>
          <li><a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="text-sm transition-colors hover:opacity-80" style="color: var(--text-secondary);">GitHub</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4" style="color: var(--title);">联系</h4>
        <ul class="space-y-2.5">
          <li>
            <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="text-sm transition-colors hover:opacity-80 flex items-center gap-2" style="color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t flex flex-col sm:flex-row items-center justify-between gap-4 text-sm" style="border-color: var(--content-border); color: var(--text-secondary);">
      <p>© {new Date().getFullYear()} Panda Lab</p>
      <p>Crafted with care</p>
    </div>
  </div>
</footer>
