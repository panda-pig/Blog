---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import dict from '../../i18n/dict.js';
import { groupPostsBySlug, getLocalizedPosts, getReadingTime, formatDate } from '../../lib/posts.js';
import { projectsData } from '../../data/projects';

const { lang } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
const t = dict[lang] || dict.zh;

const allPosts = await Astro.glob('../../content/blog/*.md');
const postsBySlug = groupPostsBySlug(allPosts);
const recentPosts = getLocalizedPosts(postsBySlug, lang);
const homeProjects = projectsData[lang as 'zh' | 'en' | 'ja'] || projectsData.zh;
const heroImageSrcSet = '/images/home-hero-bg-v4-960.webp 960w, /images/home-hero-bg-v4-1672.webp 1672w';

---

<BaseLayout
  description={t['hero.desc']}
  lang={lang}
  heroPreload={{
    href: '/images/home-hero-bg-v4-1672.webp',
    srcset: heroImageSrcSet,
    sizes: '100vw',
    type: 'image/webp',
  }}
>
  <Header lang={lang} overlay />

  <main class="min-h-screen">
    <section class="home-cover" aria-labelledby="home-cover-title">
      <picture class="home-cover__image" aria-hidden="true">
        <source
          type="image/webp"
          srcset={heroImageSrcSet}
          sizes="100vw"
        />
        <source
          type="image/jpeg"
          srcset="/images/home-hero-bg-v4-960.jpg 960w, /images/home-hero-bg-v4-1672.jpg 1672w"
          sizes="100vw"
        />
        <img
          class="home-cover__image-img"
          src="/images/home-hero-bg-v4-1672.jpg"
          srcset="/images/home-hero-bg-v4-960.jpg 960w, /images/home-hero-bg-v4-1672.jpg 1672w"
          sizes="100vw"
          width="1672"
          height="941"
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="home-cover__shade" aria-hidden="true"></div>
      <div class="home-cover__grain" aria-hidden="true"></div>

      <div class="section-container home-cover__content">
        <div class="home-cover__copy">
          <div class="home-cover__eyebrow" aria-label="Panda's digital garden">
            <span class="home-cover__mark">
              <img src="/images/avatar.jpg" alt="Panda" class="w-full h-full object-cover rounded-xl" />
            </span>
            <span class="home-cover__eyebrow-copy">
              <span class="home-cover__eyebrow-title">PANDA</span>
              <span class="home-cover__eyebrow-meta">WEB / DATA / AI</span>
            </span>
          </div>

          <h1 id="home-cover-title" class="home-cover__title">{t['hero.title']}</h1>
          <p class="home-cover__typed" aria-label={t['hero.typed']}>
            <span class="home-cover__typed-text" data-typed-text={t['hero.typed']}>{t['hero.typed']}</span>
          </p>
          <p class="home-cover__desc">{t['hero.desc']}</p>

          <div class="home-cover__actions">
            <a href={`${prefix}/blog`} class="btn-hero-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
              <span>{t['hero.cta1']}</span>
            </a>
            <a href={`${prefix}/contact`} class="btn-hero-secondary">
              <span >{t['hero.cta2']}</span>
            </a>
          </div>

          <p class="home-cover__motto">— What you're not changing, you're choosing.</p>

        </div>
      </div>

      <a href="#home-content" class="home-cover__scroll" aria-label="Scroll to homepage content">
        <span></span>
      </a>
    </section>

    <script>
      function initTypewriter() {
        const typedEl = document.querySelector('.home-cover__typed-text');
        if (!typedEl || typedEl.classList.contains('is-typing') || typedEl.classList.contains('is-complete')) return;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        const text = typedEl.dataset.typedText || typedEl.textContent || '';
        typedEl.textContent = '';
        typedEl.classList.add('is-typing');

        let index = 0;
        const typeNext = () => {
          typedEl.textContent = text.slice(0, index);
          index += 1;
          if (index <= text.length) {
            window.setTimeout(typeNext, 68);
          } else {
            typedEl.classList.remove('is-typing');
            typedEl.classList.add('is-complete');
          }
        };

        window.setTimeout(typeNext, 420);
      }
      document.addEventListener('astro:page-load', initTypewriter);
    </script>

    <style>
      .home-cover {
        min-height: clamp(560px, calc(100svh - 72px), 760px);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: stretch;
        isolation: isolate;
        background: #eef2f7;
      }

      .home-cover__image,
      .home-cover__shade,
      .home-cover__grain {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .home-cover__image {
        z-index: -4;
        display: block;
        overflow: hidden;
      }

      .home-cover__image-img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
        filter: saturate(0.94) contrast(1.01) brightness(1.03);
      }

      .home-cover__shade {
        z-index: -3;
        background:
          radial-gradient(ellipse at 72% 44%, rgba(255, 252, 244, 0.05) 0%, rgba(255, 252, 244, 0.03) 34%, rgba(255, 252, 244, 0) 62%),
          linear-gradient(180deg, rgba(255, 250, 240, 0.18) 0%, rgba(255, 253, 248, 0.06) 34%, rgba(255, 255, 255, 0) 66%);
      }

      .home-cover__grain {
        z-index: -2;
        opacity: 0.012;
        background-image:
          linear-gradient(rgba(58, 71, 91, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(58, 71, 91, 0.045) 1px, transparent 1px),
          radial-gradient(circle at 1px 1px, rgba(58, 71, 91, 0.1) 1px, transparent 0);
        background-size: 80px 80px, 80px 80px, 18px 18px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.75), transparent 92%);
      }

      .home-cover__content {
        width: 100%;
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(520px, 640px);
        align-items: center;
        padding-top: 76px;
        padding-bottom: 104px;
      }

      .home-cover__copy {
        grid-column: 2;
        max-width: 640px;
        text-align: left;
        position: relative;
        isolation: isolate;
      }

      .home-cover__copy::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset: -1.6rem -2rem -1.35rem -1.45rem;
        border-radius: 48% 52% 46% 54%;
        background:
          radial-gradient(ellipse at 54% 44%, rgba(255, 252, 244, 0.26) 0%, rgba(255, 252, 244, 0.13) 44%, rgba(255, 252, 244, 0) 76%),
          linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 251, 244, 0.08) 46%, rgba(255, 251, 244, 0.04) 100%);
      }

      .home-cover__eyebrow {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.85rem;
        margin-bottom: 1.35rem;
        color: #24304a;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .home-cover__mark {
        width: 2.35rem;
        height: 2.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.7rem;
        overflow: hidden;
        border: 1px solid rgba(33, 47, 69, 0.18);
        box-shadow: 0 12px 28px rgba(56, 70, 96, 0.16);
      }

      .home-cover__eyebrow-copy {
        display: grid;
        gap: 0.26rem;
      }

      .home-cover__eyebrow-title {
        color: #253149;
      }

      .home-cover__eyebrow-meta {
        color: #7891b6;
        letter-spacing: 0.12em;
      }

      .home-cover__divider {
        width: 1px;
        height: 1rem;
        background: rgba(245, 245, 243, 0.34);
      }

      .home-cover__title {
        max-width: 640px;
        margin: 0;
        color: #182338;
        font-family: 'Noto Serif', 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', serif;
        font-size: clamp(2.55rem, 4.05vw, 4rem);
        font-weight: 600;
        line-height: 1.04;
        letter-spacing: 0;
        white-space: nowrap;
        overflow-wrap: normal;
        text-shadow: 0 18px 46px rgba(255, 255, 255, 0.72);
      }

      .home-cover__typed {
        max-width: 540px;
        min-height: 3.9rem;
        margin: 1.15rem 0 0;
        color: #4f5d72;
        font-size: clamp(1.08rem, 1.78vw, 1.36rem);
        line-height: 1.58;
        font-weight: 600;
      }

      .home-cover__typed-text {
        display: inline;
        text-shadow: 0 12px 30px rgba(255, 255, 255, 0.78);
      }

      .home-cover__typed-text.is-typing::after {
        content: '';
        display: inline-block;
        width: 2px;
        height: 1.05em;
        margin-left: 0.18em;
        vertical-align: -0.16em;
        background: #76a0d7;
        animation: home-caret 0.82s steps(1) infinite;
      }

      .home-cover__typed-text.is-complete::after {
        opacity: 0.7;
      }

      .home-cover__desc {
        max-width: 540px;
        margin: 0.65rem 0 0;
        color: #667286;
        font-size: clamp(0.94rem, 1.35vw, 1.08rem);
        line-height: 1.8;
        font-weight: 500;
      }

      .home-cover__actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1.7rem;
      }

      .home-cover__scroll {
        position: absolute;
        left: 50%;
        bottom: 2.1rem;
        z-index: 3;
        width: 2.15rem;
        height: 2.15rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: translateX(-50%);
        border-radius: 999px;
        border: 1px solid rgba(31, 42, 61, 0.14);
        background: rgba(255, 255, 255, 0.62);
        box-shadow: 0 14px 34px rgba(55, 72, 100, 0.14);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .home-cover__scroll:hover {
        transform: translateX(-50%) translateY(2px);
        border-color: #81aed9;
        background: rgba(129, 174, 217, 0.24);
      }

      .home-cover__scroll span {
        width: 0.55rem;
        height: 0.55rem;
        border-right: 2px solid rgba(31, 42, 61, 0.68);
        border-bottom: 2px solid rgba(31, 42, 61, 0.68);
        transform: translateY(-2px) rotate(45deg);
      }

      @keyframes home-caret {
        50% {
          opacity: 0;
        }
      }

      @media (max-width: 768px) {
        .home-cover {
          min-height: calc(100svh - 72px);
        }

        .home-cover__image-img {
          object-position: 37% center;
          filter: saturate(0.92) contrast(1.01) brightness(1.03);
        }

        .home-cover__shade {
          background:
            radial-gradient(ellipse at 44% 34%, rgba(255, 252, 244, 0.07) 0%, rgba(255, 252, 244, 0.03) 42%, rgba(255, 252, 244, 0) 72%),
            linear-gradient(180deg, rgba(255, 250, 240, 0.16) 0%, rgba(255, 253, 248, 0.04) 44%, rgba(255, 255, 255, 0) 74%);
        }

        .home-cover__content {
          display: block;
          padding-top: clamp(96px, 14svh, 116px);
          padding-bottom: 80px;
        }

        .home-cover__copy {
          width: 100%;
          max-width: calc(100vw - 3rem);
          margin: 0;
          text-align: left;
        }

        .home-cover__copy::before {
          inset: -1rem -1.5rem -1rem -0.5rem;
          background:
            radial-gradient(ellipse at 38% 42%, rgba(255, 252, 244, 0.38) 0%, rgba(255, 252, 244, 0.18) 52%, rgba(255, 252, 244, 0) 78%),
            linear-gradient(90deg, rgba(255, 252, 244, 0.1), rgba(255, 252, 244, 0));
        }

        .home-cover__eyebrow {
          gap: 0.55rem;
          margin-bottom: 1rem;
          font-size: 0.65rem;
        }

        .home-cover__title {
          max-width: 100%;
          white-space: normal;
          font-size: clamp(1.75rem, 8vw, 2.2rem);
          line-height: 1.14;
        }

        .home-cover__typed {
          width: 100%;
          max-width: calc(100vw - 3rem);
          min-height: 5rem;
          margin-top: 0.9rem;
          font-size: clamp(0.93rem, 4vw, 1rem);
          overflow-wrap: break-word;
          white-space: normal;
          word-break: normal;
        }

        .home-cover__desc {
          width: 100%;
          max-width: calc(100vw - 3rem);
          font-size: 0.875rem;
          overflow-wrap: break-word;
          white-space: normal;
          word-break: normal;
          line-height: 1.7;
        }

        .home-cover__actions {
          justify-content: flex-start;
          margin-top: 1.35rem;
          gap: 0.625rem;
        }

      }

      @media (max-width: 430px) {
        .home-cover__eyebrow {
          font-size: 0.6rem;
          gap: 0.4rem;
          margin-bottom: 0.8rem;
        }
      }

      @media (max-width: 639px) {
        .home-cover__copy,
        .home-cover__typed,
        .home-cover__desc {
          max-width: min(100%, 21rem);
        }
      }

      .home-cover__motto {
        max-width: 540px;
        margin: 1.4rem 0 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: clamp(0.78rem, 1.1vw, 0.88rem);
        font-style: italic;
        font-weight: 400;
        color: #4a6480;
        letter-spacing: 0.02em;
        line-height: 1.6;
        text-shadow: 0 2px 12px rgba(255,255,255,0.9), 0 8px 24px rgba(255,255,255,0.7);
      }

      @media (max-width: 768px) {
        .home-cover__motto {
          max-width: 100%;
          font-size: 0.75rem;
          margin-top: 1.1rem;
        }
      }

      @media (max-width: 639px) {
        .home-cover__motto {
          max-width: min(100%, 21rem);
        }
      }
    </style>

    <div id="home-content" class="section-container" style="margin-top: -28px; position: relative; z-index: 10; margin-bottom: 48px;">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-3">
        <div class="info-card p-4 md:p-5">
          <div class="text-[10px] font-semibold uppercase tracking-[0.1em] mb-1.5" style="color: var(--text-muted);">{t['info.origin']}</div>
          <div class="text-[14px] md:text-[15px] font-semibold leading-snug" style="color: var(--text);">{t['info.originVal']}</div>
        </div>
        <div class="info-card p-4 md:p-5">
          <div class="text-[10px] font-semibold uppercase tracking-[0.1em] mb-1.5" style="color: var(--text-muted);">{t['info.stack']}</div>
          <div class="text-[14px] md:text-[15px] font-semibold leading-snug" style="color: var(--text);">{t['info.stackVal']}</div>
        </div>
        <div class="info-card p-4 md:p-5">
          <div class="text-[10px] font-semibold uppercase tracking-[0.1em] mb-1.5" style="color: var(--text-muted);">{t['info.focus']}</div>
          <div class="text-[14px] md:text-[15px] font-semibold leading-snug" style="color: var(--text);">{t['info.focusVal']}</div>
        </div>
        <div class="info-card p-4 md:p-5">
          <div class="text-[10px] font-semibold uppercase tracking-[0.1em] mb-1.5" style="color: var(--text-muted);">
            <span class="inline-block w-1.5 h-1.5 rounded-full mr-1 align-middle" style="background: #81aed9;"></span>
            {t['info.status']}
          </div>
          <div class="text-[14px] md:text-[15px] font-semibold leading-snug" style="color: var(--text);">{t['info.statusVal']}</div>
        </div>
      </div>
    </div>

    <section class="section-container pb-16 md:pb-20">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2.5">
            <div class="w-4 h-[1.5px] rounded-full" style="background: var(--primary);"></div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.14em]" style="color: var(--primary);">{t['musing.title']}</span>
          </div>
          <h2 class="font-serif text-xl md:text-2xl font-semibold leading-snug" style="color: var(--text); text-wrap: balance;">{t['musing.subtitle']}</h2>
        </div>
        <a href={`${prefix}/blog`} class="hidden md:flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider transition-opacity hover:opacity-60 shrink-0 ml-4" style="color: var(--text-secondary);">{t['musing.viewAll']}<svg class="w-3.5 h-3.5 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {recentPosts.map((post: any, index: number) => {
          const slug = post.resolvedSlug;
          const readingTime = getReadingTime(post.rawContent);
          const formattedDate = formatDate(post.frontmatter.date, lang);
          const category = post.frontmatter.tags?.[0] || t['musing.category'];
          const borderColors = ['#81aed9', '#ff8562', '#4a6ea8'];
          const borderColor = borderColors[index % borderColors.length];

          return (
            <a href={`${prefix}/blog/${slug}`} class="card-fluid group flex flex-col" style={`border-left: 4px solid ${borderColor};`}>
              <div class="p-5 md:p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class="category-badge">{category}</span>
                  <span class="text-[10px] uppercase tracking-wider" style="color: var(--text-muted);">{formattedDate} · {readingTime} {t['musing.minRead']}</span>
                </div>

                <h3 class="font-serif text-[16px] font-semibold leading-snug mb-2.5 group-hover:opacity-75 transition-opacity" style="color: var(--text); text-wrap: balance;">{post.frontmatter.title}</h3>

                <p class="text-[13px] leading-relaxed mb-4 flex-1" style="color: var(--text-secondary);">
                  {post.frontmatter.description}
                </p>

                <div class="flex gap-1.5 pt-3 border-t" style="border-color: var(--border);">
                  {post.frontmatter.tags?.slice(0, 2).map((tag: string) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
      ) : (
        <div class="card-fluid p-10 text-center">
          <p class="text-sm" style="color: var(--text-muted);" >{t['musing.empty']}</p>
          <a href={`${prefix}/blog`} class="inline-flex items-center gap-1.5 mt-4 text-xs font-medium uppercase tracking-wider transition-colors hover:opacity-70" style="color: var(--primary);" >{t['musing.viewAll']}<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      )}

      <div class="mt-6 md:hidden">
        <a href={`${prefix}/blog`} class="inline-flex items-center gap-2 text-sm font-semibold transition-opacity hover:opacity-70" style="color: var(--primary);">{t['musing.viewAll']}<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </section>

    <section class="section-container pb-20 md:pb-24">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2.5">
            <div class="w-4 h-[1.5px] rounded-full" style="background: var(--primary);"></div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.14em]" style="color: var(--primary);">{t['proj.title']}</span>
          </div>
          <h2 class="font-serif text-xl md:text-2xl font-semibold leading-snug" style="color: var(--text); text-wrap: balance;">{t['proj.desc']}</h2>
        </div>
        <a href={`${prefix}/projects`} class="hidden md:flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider transition-opacity hover:opacity-60 shrink-0 ml-4" style="color: var(--text-secondary);">
          {t['musing.viewAll']}
          <svg class="w-3.5 h-3.5 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {homeProjects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            tags={project.tags}
            link={project.link}
            status={project.status}
            lang={lang}
          />
        ))}
      </div>

      <div class="mt-5 md:hidden">
        <a href={`${prefix}/projects`} class="inline-flex items-center gap-2 text-sm font-semibold transition-opacity hover:opacity-70" style="color: var(--primary);">
          {t['musing.viewAll']}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <section class="section-container pb-24 md:pb-28">
      <div class="card-fluid p-7 md:p-10 relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(135deg, rgba(129,174,217,0.07) 0%, transparent 55%);"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">

          <div class="flex items-start gap-4 flex-1 min-w-0">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 mt-0.5" style="background: var(--primary-light);">
              <svg class="w-5 h-5" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="text-lg md:text-xl font-bold mb-1.5" style="color: var(--text);">{t['newsletter.title']}</h2>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{t['newsletter.desc']}</p>
            </div>
          </div>

          <div class="shrink-0 w-full md:w-auto">
            {import.meta.env.PUBLIC_BUTTONDOWN_URL ? (
              <>
                <form
                  id="newsletter-form"
                  class="flex gap-2"
                  data-buttondown-url={import.meta.env.PUBLIC_BUTTONDOWN_URL}
                >
                  <input
                    type="email"
                    name="email"
                    class="flex-1 md:w-56 px-4 py-2.5 rounded-xl text-sm transition-all focus:outline-none focus:ring-2"
                    style="background: var(--bg); border: 1px solid var(--border); color: var(--text); --tw-ring-color: var(--primary);"
                    placeholder={t["newsletter.placeholder"]}
                    required
                  />
                  <button type="submit" class="btn-primary whitespace-nowrap">{t['newsletter.btn']}</button>
                </form>
                <p id="newsletter-status" class="text-xs mt-2 hidden" style="color: var(--text-muted);"></p>
              </>
            ) : (
              <div class="flex flex-col gap-2">
                <div class="flex gap-2">
                  <input
                    type="email"
                    disabled
                    class="flex-1 md:w-56 px-4 py-2.5 rounded-xl text-sm opacity-50 cursor-not-allowed"
                    style="background: var(--bg); border: 1px solid var(--border); color: var(--text);"
                    placeholder={t["newsletter.placeholder"]}
                  />
                  <button disabled class="btn-primary whitespace-nowrap opacity-60 cursor-not-allowed">{t['newsletter.btn']}</button>
                </div>
                <p class="text-xs" style="color: var(--text-muted);">{t['newsletter.comingSoon']}</p>
              </div>
            )}
          </div>

        </div>
      </div>
    </section>

    <script>
      function initNewsletter() {
        const newsletterForm = document.getElementById('newsletter-form');
        if (!newsletterForm) return;
        const buttondownUrl = newsletterForm.dataset.buttondownUrl;
        newsletterForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = newsletterForm.querySelector('button');
          const statusEl = document.getElementById('newsletter-status');
          const htmlLang = document.documentElement.lang || 'zh-CN';
          const currentLang = htmlLang.startsWith('en') ? 'en' : htmlLang.startsWith('ja') ? 'ja' : 'zh';
          const dict = window.i18nDict?.[currentLang] || window.i18nDict?.zh || {};
          if (!buttondownUrl) {
            statusEl.classList.remove('hidden');
            statusEl.textContent = dict['newsletter.comingSoon'] || '订阅功能即将上线';
            return;
          }
          btn.disabled = true;
          btn.textContent = '...';
          statusEl.classList.add('hidden');
          try {
            const formData = new FormData();
            formData.append('email', newsletterForm.email.value);
            const res = await fetch(buttondownUrl, { method: 'POST', body: formData });
            if (res.ok) {
              statusEl.classList.remove('hidden');
              statusEl.style.color = '#1a7a2e';
              statusEl.textContent = dict['newsletter.success'] || '订阅成功！请检查邮箱确认。';
              newsletterForm.reset();
            } else {
              throw new Error('Failed');
            }
          } catch {
            statusEl.classList.remove('hidden');
            statusEl.style.color = '#c41e3a';
            statusEl.textContent = dict['newsletter.error'] || '订阅失败，请稍后重试。';
          } finally {
            btn.disabled = false;
            btn.textContent = dict['newsletter.btn'] || '立即订阅';
          }
        });
      }
      document.addEventListener('astro:page-load', initNewsletter);
    </script>
  </main>
  <Footer lang={lang} />
</BaseLayout>
