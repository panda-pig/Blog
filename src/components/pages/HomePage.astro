---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import dict from '../../i18n/dict.js';

const { lang } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
const t = dict[lang] || dict.zh;

const allPosts = await Astro.glob('../../content/blog/*.md');
const postsBySlug: Record<string, Record<string, any>> = {};
allPosts.forEach((post: any) => {
  const slug = post.frontmatter.slug || post.file.split('/').pop().replace('.md', '').replace(/\.(en|ja)$/, '');
  const postLang = post.frontmatter.lang || 'zh';
  if (!postsBySlug[slug]) postsBySlug[slug] = {};
  postsBySlug[slug][postLang] = post;
});

const recentPosts = Object.entries(postsBySlug)
  .map(([slug, langs]) => {
    const post = langs[lang] || langs['zh'];
    return post ? { ...post, resolvedSlug: slug } : null;
  })
  .filter(Boolean)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

const localeStr = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';

const coverDesigns = [
  { label: 'Thinking', number: '01' },
  { label: 'Project', number: '02' },
  { label: 'Blog', number: '03' },
  { label: 'Thinking', number: '04' },
  { label: 'Learning', number: '05' },
];
---

<BaseLayout description="Panda Blog - panda 的想法与代码数字实验室" lang={lang}>
  <Header lang={lang} />

  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="home-cover" aria-labelledby="home-cover-title">
      <div class="home-cover__image" aria-hidden="true"></div>
      <div class="home-cover__shade" aria-hidden="true"></div>
      <div class="home-cover__grain" aria-hidden="true"></div>

      <div class="section-container home-cover__content">
        <div class="home-cover__eyebrow" aria-label="Panda, Web Data AI">
          <span class="home-cover__mark">P</span>
          <span>Panda</span>
          <span class="home-cover__divider"></span>
          <span>Web / Data / AI</span>
        </div>

        <h1 id="home-cover-title" class="home-cover__title">{t['hero.title']}</h1>
        <p class="home-cover__typed" aria-label={t['hero.typed']}>
          <span class="home-cover__typed-text" data-typed-text={t['hero.typed']}>{t['hero.typed']}</span>
        </p>
        <p class="home-cover__desc">{t['hero.desc']}</p>

        <div class="home-cover__actions">
          <a href={`${prefix}/blog`} class="btn-hero-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            <span data-i18n="hero.cta1">浏览文章</span>
          </a>
          <a href={`${prefix}/contact`} class="btn-hero-secondary">
            <span data-i18n="hero.cta2">打个招呼</span>
          </a>
        </div>

      </div>

      <a href="#home-content" class="home-cover__scroll" aria-label="Scroll to homepage content">
        <span></span>
      </a>
    </section>

    <script>
      const typedEl = document.querySelector('.home-cover__typed-text');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (typedEl instanceof HTMLElement && !prefersReducedMotion) {
        const text = typedEl.dataset.typedText || typedEl.textContent || '';
        typedEl.textContent = '';
        typedEl.classList.add('is-typing');

        let index = 0;
        const typeNext = () => {
          typedEl.textContent = text.slice(0, index);
          index += 1;

          if (index <= text.length) {
            window.setTimeout(typeNext, 68);
          } else {
            typedEl.classList.add('is-complete');
          }
        };

        window.setTimeout(typeNext, 420);
      }
    </script>

    <style>
      .home-cover {
        min-height: calc(100svh - 72px);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        isolation: isolate;
        background: #1e2328;
      }

      .home-cover__image,
      .home-cover__shade,
      .home-cover__grain {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .home-cover__image {
        z-index: -4;
        background-image: url('/images/home-hero-bg.png');
        background-position: center;
        background-size: cover;
        transform: scale(1.02);
        filter: saturate(0.72) contrast(1.05) brightness(0.92);
      }

      .home-cover__shade {
        z-index: -3;
        background:
          radial-gradient(ellipse at 50% 43%, rgba(245, 245, 243, 0.15) 0%, rgba(0, 0, 0, 0.36) 42%, rgba(0, 0, 0, 0.72) 100%),
          linear-gradient(180deg, rgba(245, 245, 243, 0.1) 0%, rgba(0, 0, 0, 0.42) 52%, rgba(0, 0, 0, 0.84) 100%),
          linear-gradient(90deg, rgba(0, 0, 0, 0.62) 0%, rgba(51, 51, 51, 0.14) 48%, rgba(0, 0, 0, 0.56) 100%);
        backdrop-filter: saturate(0.72) brightness(0.9);
        -webkit-backdrop-filter: saturate(0.72) brightness(0.9);
      }

      .home-cover__grain {
        z-index: -2;
        opacity: 0.16;
        background-image:
          linear-gradient(rgba(245,245,243,0.075) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245,245,243,0.06) 1px, transparent 1px),
          radial-gradient(circle at 1px 1px, rgba(245,245,243,0.16) 1px, transparent 0);
        background-size: 72px 72px, 72px 72px, 18px 18px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.75), transparent 92%);
      }

      .home-cover__content {
        width: 100%;
        position: relative;
        z-index: 2;
        padding-top: 72px;
        padding-bottom: 96px;
        text-align: center;
      }

      .home-cover__eyebrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        color: rgba(245, 245, 243, 0.78);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .home-cover__mark {
        width: 2.25rem;
        height: 2.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        background: rgba(129, 174, 217, 0.72);
        border: 1.5px solid rgba(0, 0, 0, 0.8);
        color: #000000;
        box-shadow: 3px -3px 0 rgba(0, 0, 0, 0.58);
        font-family: 'DM Serif Display', 'Noto Serif SC', serif;
        font-size: 1.4rem;
        line-height: 1;
      }

      .home-cover__divider {
        width: 1px;
        height: 1rem;
        background: rgba(245, 245, 243, 0.34);
      }

      .home-cover__title {
        max-width: 760px;
        margin: 0 auto;
        color: #fffdf5;
        font-family: 'DM Serif Display', 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', serif;
        font-size: clamp(2.35rem, 5.2vw, 4.8rem);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: 0;
        overflow-wrap: anywhere;
        text-wrap: balance;
        text-shadow: 0 16px 44px rgba(0, 0, 0, 0.48);
      }

      .home-cover__typed {
        max-width: 760px;
        min-height: 2.4rem;
        margin: 1.35rem auto 0;
        color: rgba(255, 253, 245, 0.92);
        font-size: clamp(1rem, 2.1vw, 1.45rem);
        line-height: 1.6;
        font-weight: 500;
      }

      .home-cover__typed-text {
        display: inline;
        text-shadow: 0 10px 32px rgba(0, 0, 0, 0.38);
      }

      .home-cover__typed-text.is-typing::after {
        content: '';
        display: inline-block;
        width: 2px;
        height: 1.05em;
        margin-left: 0.18em;
        vertical-align: -0.16em;
        background: #ff8562;
        animation: home-caret 0.82s steps(1) infinite;
      }

      .home-cover__typed-text.is-complete::after {
        opacity: 0.7;
      }

      .home-cover__desc {
        width: min(100%, 620px);
        margin: 1.2rem auto 0;
        color: rgba(255, 253, 245, 0.74);
        font-size: 1rem;
        line-height: 1.8;
      }

      .home-cover__actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 2.2rem;
      }

      .home-cover__scroll {
        position: absolute;
        left: 50%;
        bottom: 2.1rem;
        z-index: 3;
        width: 2.15rem;
        height: 2.15rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: translateX(-50%);
        border-radius: 999px;
        border: 1.5px solid rgba(245, 245, 243, 0.46);
        background: rgba(245, 245, 243, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .home-cover__scroll:hover {
        transform: translateX(-50%) translateY(2px);
        border-color: #81aed9;
        background: rgba(129, 174, 217, 0.24);
      }

      .home-cover__scroll span {
        width: 0.55rem;
        height: 0.55rem;
        border-right: 2px solid rgba(255, 253, 245, 0.82);
        border-bottom: 2px solid rgba(255, 253, 245, 0.82);
        transform: translateY(-2px) rotate(45deg);
      }

      @keyframes home-caret {
        50% {
          opacity: 0;
        }
      }

      @media (max-width: 768px) {
        .home-cover {
          min-height: calc(100svh - 72px);
        }

        .home-cover__content {
          padding-top: 52px;
          padding-bottom: 92px;
        }

        .home-cover__eyebrow {
          gap: 0.55rem;
          margin-bottom: 1.15rem;
          font-size: 0.65rem;
        }

        .home-cover__title {
          max-width: 18rem;
          font-size: clamp(1.95rem, 8.4vw, 2.75rem);
          line-height: 1.16;
        }

        .home-cover__typed {
          max-width: 18.5rem;
          min-height: 4.8rem;
          margin-top: 1rem;
          font-size: 1rem;
        }

        .home-cover__desc {
          max-width: 18.5rem;
          font-size: 0.94rem;
        }

      }

      @media (max-width: 430px) {
        .home-cover__eyebrow {
          transform: scale(0.92);
          transform-origin: center;
        }
      }
    </style>

    <!-- P9: Info Cards -->
    <div id="home-content" class="section-container" style="margin-top: -36px; position: relative; z-index: 10; margin-bottom: 64px;">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <div class="card-fluid p-5 md:p-6">
          <div class="text-[11px] font-semibold uppercase tracking-wider mb-2" style="color: var(--text-muted);" data-i18n="info.origin">来源</div>
          <div class="text-[15px] font-semibold" style="color: var(--text);" data-i18n="info.originVal">地球🌍</div>
        </div>
        <div class="card-fluid p-5 md:p-6">
          <div class="text-[11px] font-semibold uppercase tracking-wider mb-2" style="color: var(--text-muted);" data-i18n="info.stack">兴趣</div>
          <div class="text-[15px] font-semibold" style="color: var(--text);" data-i18n="info.stackVal">摄影、模型、美食、旅行</div>
        </div>
        <div class="card-fluid p-5 md:p-6">
          <div class="text-[11px] font-semibold uppercase tracking-wider mb-2" style="color: var(--text-muted);" data-i18n="info.focus">聚焦</div>
          <div class="text-[15px] font-semibold" style="color: var(--text);" data-i18n="info.focusVal">Web / Data / AI / 语言学习</div>
        </div>
        <div class="card-fluid p-5 md:p-6">
          <div class="text-[11px] font-semibold uppercase tracking-wider mb-2" style="color: var(--text-muted);">
            <span class="inline-block w-2 h-2 rounded-full mr-1.5" style="background: #81aed9; box-shadow: 0 0 0 3px rgba(129,174,217,0.3);"></span>
            <span data-i18n="info.status">状态</span>
          </div>
          <div class="text-[15px] font-semibold" style="color: var(--text);" data-i18n="info.statusVal">持续构建中</div>
        </div>
      </div>
    </div>

    <!-- Recent Thoughts -->
    <section class="section-container pb-16 md:pb-20">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-3 mb-1">
            <div class="w-5 h-[2px] rounded-full" style="background: var(--primary);"></div>
            <h2 class="text-xs font-bold uppercase tracking-[0.12em]" style="color: var(--text-muted);" data-i18n="musing.title">近期思考</h2>
          </div>
          <p class="text-xs" style="color: var(--text-muted);" data-i18n="musing.subtitle">实验室笔记与理论探索。</p>
        </div>
        <a href={`${prefix}/blog`} class="hidden md:flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider transition-colors hover:opacity-70" style="color: var(--text-secondary);" data-i18n="musing.viewAll">
          查看全部
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- P8: Responsive grid - single column on mobile -->
      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {recentPosts.map((post: any, index: number) => {
          const slug = post.resolvedSlug;
          const readingTime = Math.ceil((post.rawContent?.length || 0) / 400) || 3;
          const formattedDate = new Date(post.frontmatter.date).toLocaleDateString(localeStr, {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          const category = post.frontmatter.tags?.[0] || t['musing.category'];
          const design = coverDesigns[index % coverDesigns.length];
          const gradColors = [
            ['#81aed9', '#4d7fae'],
            ['#ff8562', '#d95e3e'],
            ['#333333', '#000000'],
            ['#f5f5f3', '#cfddee'],
            ['#55a1ea', '#81aed9'],
          ];
          const gradient = gradColors[index % gradColors.length];
          // P4: Get first character of title for cover
          const titleInitial = post.frontmatter.title?.charAt(0) || '#';

          return (
            <div class="card-fluid group flex flex-col">
              <!-- P4: Enhanced cover with category label, number, and title initial -->
              <div class="h-44 w-full relative overflow-hidden" style={`background: linear-gradient(135deg, ${gradient[0]} 0%, ${gradient[1]} 100%);`}>
                <!-- Dot pattern overlay -->
                <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 24px 24px;"></div>
                <!-- Large title initial -->
                <span class="absolute bottom-2 right-4 font-serif text-6xl font-light leading-none" style="color: rgba(255,255,255,0.08);">{titleInitial}</span>
                <!-- Category badge -->
                <div class="absolute top-3 left-3">
                  <span class="category-badge" data-i18n="musing.category">{category}</span>
                </div>
                <!-- Number indicator -->
                <div class="absolute top-3 right-3">
                  <span class="text-[11px] font-mono font-semibold tracking-wider" style="color: rgba(255,255,255,0.35);">{design.number}</span>
                </div>
              </div>

              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3 text-[11px] uppercase tracking-wider" style="color: var(--text-muted);">
                  <span>{formattedDate}</span>
                  <span>·</span>
                  <span>{readingTime} <span data-i18n="musing.minRead">分钟阅读</span></span>
                </div>

                <a href={`${prefix}/blog/${slug}`} class="block mb-2 group-hover:opacity-80 transition-opacity">
                  <h3 class="font-serif text-lg font-semibold leading-snug" style="color: var(--text);">{post.frontmatter.title}</h3>
                </a>

                <p class="text-sm leading-relaxed mb-4 flex-1" style="color: var(--text-secondary);">
                  {post.frontmatter.description}
                </p>

                <div class="flex items-center justify-between pt-4 border-t" style="border-color: var(--border);">
                  <div class="flex gap-1.5">
                    {post.frontmatter.tags?.slice(0, 2).map((tag: string) => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      ) : (
        <div class="card-fluid p-10 text-center">
          <p class="text-sm" style="color: var(--text-muted);" data-i18n="musing.empty">还没有文章，稍后再来看看。</p>
          <a href={`${prefix}/blog`} class="inline-flex items-center gap-1.5 mt-4 text-xs font-medium uppercase tracking-wider transition-colors hover:opacity-70" style="color: var(--primary);" data-i18n="musing.viewAll">
            查看全部
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      )}

      <div class="mt-6 md:hidden text-center">
        <a href={`${prefix}/blog`} class="inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-wider" style="color: var(--text-secondary);" data-i18n="musing.viewAll">
          查看全部
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- P6: Interactive Experiments -->
    <section class="section-container pb-20 md:pb-24">
      <div class="flex items-center gap-3 mb-7">
        <div class="w-5 h-[2px] rounded-full" style="background: var(--primary);"></div>
        <h2 class="text-xs font-bold uppercase tracking-[0.12em]" style="color: var(--text-muted);" data-i18n="exp.title">随手小实验</h2>
      </div>

      <div style="background: var(--accent-warm); border-radius: 1rem; padding: 28px; border: 1px solid var(--border);">
        <div class="flex flex-col md:flex-row gap-8 md:gap-10">
          <div class="flex-1">
            <h2 class="font-serif text-2xl md:text-[28px] font-normal mb-2" style="color: var(--text); letter-spacing: -0.01em;" data-i18n="exp.title">随手小实验</h2>
            <p class="text-[15px] leading-relaxed mb-6 max-w-md" style="color: var(--text-secondary);" data-i18n="exp.desc">
              这里收集一些我做着玩的原型、小工具和灵感实验。不一定成熟，但都是真实想法的试作品。
            </p>

            <div class="space-y-3">
              <a href={`${prefix}/projects`} class="flex items-start gap-3 p-3 rounded-xl transition-all hover:translate-x-1" style="background: var(--bg); border: 1px solid var(--border);">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background: rgba(129,174,217,0.24);">
                  <span class="text-lg">✏️</span>
                </div>
                <div>
                  <h4 class="text-sm font-semibold mb-0.5" style="color: var(--text);" data-i18n="exp.canvas">随手画布</h4>
                  <p class="text-xs" style="color: var(--text-secondary);" data-i18n="exp.canvasDesc">一个随手涂鸦就能生成 UI 布局原型的 AI 小工具。</p>
                </div>
              </a>

              <a href={`${prefix}/projects`} class="flex items-start gap-3 p-3 rounded-xl transition-all hover:translate-x-1" style="background: var(--bg); border: 1px solid var(--border);">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background: rgba(255,133,98,0.18);">
                  <span class="text-lg">🎨</span>
                </div>
                <div>
                  <h4 class="text-sm font-semibold mb-0.5" style="color: var(--text);" data-i18n="exp.chroma">色彩日记</h4>
                  <p class="text-xs" style="color: var(--text-secondary);" data-i18n="exp.chromaDesc">记录每天看到的颜色，生成个人专属色板。</p>
                </div>
              </a>

              <a href={`${prefix}/projects`} class="flex items-start gap-3 p-3 rounded-xl transition-all hover:translate-x-1" style="background: var(--bg); border: 1px solid var(--border);">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background: rgba(129,174,217,0.24);">
                  <span class="text-lg">🧪</span>
                </div>
                <div>
                  <h4 class="text-sm font-semibold mb-0.5" style="color: var(--text);" data-i18n="exp.jlpt">JLPT 语法卡</h4>
                  <p class="text-xs" style="color: var(--text-secondary);" data-i18n="exp.jlptDesc">把日语语法点做成间隔重复卡片，边学边记。</p>
                </div>
              </a>
            </div>
          </div>

          <div class="shrink-0 w-full md:w-56 h-44 hidden md:flex flex-col items-center justify-center gap-3" style="background: var(--bg); border-radius: 1rem; border: 1px solid var(--border);">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full" style="background: #ff5f57;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background: #febc2e;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background: #28c840;"></span>
            </div>
            <span class="text-4xl opacity-20">🧪</span>
            <span class="text-[11px] font-mono px-2.5 py-1 rounded-md font-semibold" style="background: rgba(129,174,217,0.24); color: var(--primary);" data-i18n="exp.instance">随手实例 #042</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="section-container pb-24 md:pb-28">
      <div class="card-fluid p-8 sm:p-12 text-center max-w-3xl mx-auto relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--primary-light)]/50 via-transparent to-[var(--primary-light)]/30 pointer-events-none"></div>
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background: var(--primary-light);">
            <svg class="w-6 h-6" style="color: var(--primary);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-3" style="color: var(--text);" data-i18n="newsletter.title">订阅我的实践笔记</h2>
          <p class="mb-8 max-w-md mx-auto" style="color: var(--text-secondary);" data-i18n="newsletter.desc">
            每周分享技术见解、项目心得和学习资源。无垃圾邮件，随时取消订阅。
          </p>
          <form
            id="newsletter-form"
            class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
            data-buttondown-url={import.meta.env.PUBLIC_BUTTONDOWN_URL || ''}
          >
            <input
              type="email"
              name="email"
              class="flex-1 px-4 py-3 rounded-xl text-sm transition-all focus:outline-none focus:ring-2"
              style="background: var(--surface); border: 1px solid var(--border); color: var(--text); --tw-ring-color: var(--primary);"
              data-i18n-placeholder="newsletter.placeholder"
              placeholder="输入你的邮箱地址"
              required
            />
            <button type="submit" class="btn-primary whitespace-nowrap" data-i18n="newsletter.btn">
              立即订阅
            </button>
          </form>
          <p id="newsletter-status" class="text-xs mt-4 hidden" style="color: var(--text-muted);"></p>
        </div>
      </div>
    </section>

    <script>
      const newsletterForm = document.getElementById('newsletter-form');
      const buttondownUrl = newsletterForm?.dataset.buttondownUrl;
      newsletterForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = newsletterForm.querySelector('button');
        const statusEl = document.getElementById('newsletter-status');
        if (!buttondownUrl) {
          statusEl.classList.remove('hidden');
          statusEl.textContent = '订阅功能即将上线';
          return;
        }
        btn.disabled = true;
        btn.textContent = '...';
        statusEl.classList.add('hidden');
        try {
          const formData = new FormData();
          formData.append('email', newsletterForm.email.value);
          const res = await fetch(buttondownUrl, { method: 'POST', body: formData });
          if (res.ok) {
            statusEl.classList.remove('hidden');
            statusEl.style.color = '#1a7a2e';
            statusEl.textContent = '订阅成功！请检查邮箱确认。';
            newsletterForm.reset();
          } else {
            throw new Error('Failed');
          }
        } catch {
          statusEl.classList.remove('hidden');
          statusEl.style.color = '#c41e3a';
          statusEl.textContent = '订阅失败，请稍后重试。';
        } finally {
          btn.disabled = false;
          btn.textContent = '立即订阅';
        }
      });
    </script>
  </main>
  <Footer lang={lang} />
</BaseLayout>
