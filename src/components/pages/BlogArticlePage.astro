---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TOC from '../../components/TOC.astro';
import Giscus from '../../components/Giscus.astro';
import Donate from '../../components/Donate.astro';
import { groupPostsBySlug, getReadingTime, formatDate } from '../../lib/posts.js';
import { getArticleEmoji } from '../../lib/animalIcons.js';
import dict from '../../i18n/dict.js';

const { slug } = Astro.params;
const { lang } = Astro.props;
const prefix = lang === 'zh' ? '' : `/${lang}`;
const t = dict[lang] || dict.zh;

const allPosts = await Astro.glob('../../content/blog/*.md');
const postsBySlug = groupPostsBySlug(allPosts);

const availableLangs = Object.keys(postsBySlug[slug] || {});
const post = postsBySlug[slug]?.[lang] || postsBySlug[slug]?.['zh'];

if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content } = post;
const readingTime = getReadingTime(post.rawContent);
const formattedDate = formatDate(post.frontmatter.date, lang);
const articleEmoji = getArticleEmoji(slug);

const headings = post.getHeadings ? post.getHeadings() : [];
---

<BaseLayout title={post.frontmatter.title} description={post.frontmatter.description} slug={`${prefix}/blog/${slug}`} lang={lang}>
  <Header lang={lang} />

  <main class="min-h-screen">
    <article class="article-page pt-8 md:pt-20 pb-16 md:pb-28 mx-auto">
      
      <div class="mb-6 md:mb-12">
        <a href={`${prefix}/blog`} class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-wider transition-colors hover:opacity-70 py-1" style="color: var(--text-muted);" >{t['article.back']}</a>
      </div>

      {availableLangs.length > 1 && (
        <div class="flex items-center gap-2 mb-6 md:mb-10">
          {availableLangs.map((l) => {
            const active = l === (post.frontmatter.lang || 'zh');
            const label = l === 'zh' ? '中' : l === 'en' ? 'EN' : '日';
            const hrefPrefix = l === 'zh' ? '' : `/${l}`;
            return (
              <a
                href={`${hrefPrefix}/blog/${slug}`}
                class={`text-xs px-3 py-1 rounded-md border font-medium uppercase tracking-wider transition-colors ${active ? 'opacity-50 cursor-default pointer-events-none' : 'hover:opacity-70'}`}
                style={active ? 'background-color: var(--primary); color: #fff; border-color: var(--primary);' : 'background-color: var(--surface); color: var(--text-secondary); border-color: var(--border);'}
              >
                {label}
              </a>
            );
          })}
          <span class="text-xs ml-1" style="color: var(--text-muted);">{t['article.langSwitch']}</span>
        </div>
      )}

      <header class="article-hero article-measure">
        <div class="article-hero__icon" aria-hidden="true">
          <span class="article-hero__emoji" aria-label={articleEmoji.label}>{articleEmoji.emoji}</span>
        </div>

        <div class="article-hero__body">
          {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
            <div class="article-hero__tags">
              {post.frontmatter.tags.map((tag: string) => (
                <span class="article-ribbon-tag">#{tag}</span>
              ))}
            </div>
          )}

          <h1 class="article-title article-hero__title font-serif">
            {post.frontmatter.title}
          </h1>

          <div class="article-hero__meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {formattedDate}
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
              {readingTime} {t['article.minRead']}
            </span>
          </div>
        </div>
      </header>

      {post.frontmatter.description && (
        <p class="article-measure article-description article-lead">
          {post.frontmatter.description}
        </p>
      )}

      <div class="animal-divider animal-divider--triangles article-measure" aria-hidden="true"></div>

      <div class="article-layout flex flex-col lg:flex-row lg:gap-16 xl:gap-20">
        <div class="article-content flex-1 min-w-0">
          <div class="prose prose-lg max-w-none font-serif article-prose" data-pagefind-body style="--tw-prose-body: var(--text); --tw-prose-headings: var(--text); --tw-prose-links: var(--primary); --tw-prose-bold: var(--text); --tw-prose-counters: var(--text-muted); --tw-prose-bullets: var(--text-muted);">
            <Content />
          </div>

          <div class="animal-divider animal-divider--wave my-14 md:my-20" aria-hidden="true"></div>

          <Donate lang={lang} />

          <div class="animal-divider animal-divider--dashed my-16 md:my-24" aria-hidden="true"></div>

          <Giscus slug={post.url} lang={lang} />
        </div>
        
        <TOC headings={headings} lang={lang} />
      </div>
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .article-page {
    --animal-shadow: 0 7px 0 rgba(82, 111, 164, 0.14), 0 22px 42px rgba(52, 70, 100, 0.12);
    --animal-press: 0 4px 0 rgba(82, 111, 164, 0.14), 0 14px 28px rgba(52, 70, 100, 0.1);
    width: min(100%, 72rem);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    cursor: url('/animal-island-ui/cursors/cursor-icon.png') 4 4, auto;
    overflow-x: clip;
  }

  .article-page a,
  .article-page button {
    cursor: url('/animal-island-ui/cursors/select-cursor.svg') 4 4, pointer;
  }

  .article-page,
  .article-page * {
    box-sizing: border-box;
  }

  .article-measure {
    width: 100%;
    max-width: 52rem;
  }

  .article-layout {
    width: 100%;
    min-width: 0;
  }

  .article-content {
    width: 100%;
    max-width: 52rem;
  }

  .article-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.7rem);
    align-items: center;
    margin-bottom: 2.25rem;
    padding: clamp(1.2rem, 4vw, 2.25rem);
    border-radius: 1.55rem;
    color: #ffffff;
    background:
      radial-gradient(circle at 92% 18%, rgba(255, 255, 255, 0.28), transparent 24%),
      linear-gradient(135deg, #9eb7f1 0%, var(--accent) 54%, #819dd2 100%);
    box-shadow: var(--animal-shadow);
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
  }

  .article-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      linear-gradient(60deg, transparent 0 46%, rgba(255, 255, 255, 0.25) 46% 54%, transparent 54%),
      linear-gradient(-60deg, transparent 0 46%, rgba(255, 255, 255, 0.2) 46% 54%, transparent 54%);
    background-size: 38px 34px;
  }

  [data-theme="dark"] .article-hero {
    background:
      radial-gradient(circle at 92% 18%, rgba(255, 255, 255, 0.12), transparent 24%),
      linear-gradient(135deg, #2a3544, #1f2a3d);
  }

  .article-hero__icon {
    width: clamp(3.2rem, 7vw, 4.6rem);
    height: clamp(3.2rem, 7vw, 4.6rem);
    display: grid;
    place-items: center;
    border-radius: 1.1rem;
    background: rgba(255, 253, 245, 0.9);
    box-shadow: 0 5px 0 rgba(31, 42, 61, 0.16);
    position: relative;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .article-hero:hover .article-hero__icon {
    transform: translateY(-2px) rotate(-2deg);
  }

  .article-hero__emoji {
    display: block;
    font-size: clamp(1.9rem, 5vw, 2.65rem);
    line-height: 1;
  }

  .article-hero__body {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .article-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.8rem;
  }

  .article-ribbon-tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.25rem 0.72rem;
    border-radius: 999px;
    color: var(--primary);
    background: rgba(255, 253, 245, 0.92);
    box-shadow: inset 0 -2px 0 rgba(52, 70, 100, 0.08);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .article-hero__title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.75rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .article-hero__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .article-hero__meta svg {
    width: 1rem;
    height: 1rem;
  }

  .animal-divider {
    margin-left: auto;
    margin-right: auto;
  }

  .article-lead {
    margin-bottom: 1.65rem;
    color: var(--text-secondary);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
  }

  .animal-divider--triangles {
    width: min(19rem, 70%);
    height: 1.25rem;
    margin-bottom: 2.6rem;
    background:
      conic-gradient(from 45deg, var(--primary) 0 25%, transparent 0 100%) 0 50% / 1rem 1rem repeat-x;
    opacity: 0.78;
  }

  .animal-divider--wave {
    width: min(28rem, 82%);
    height: 0.9rem;
    background:
      radial-gradient(1rem 0.72rem at 1rem 0.78rem, transparent 0.58rem, var(--accent-warm) 0.62rem 0.72rem, transparent 0.76rem) 0 0 / 2rem 0.9rem repeat-x;
    opacity: 0.76;
  }

  .animal-divider--dashed {
    height: 1px;
    background-image: linear-gradient(90deg, var(--accent-border) 0 0.55rem, transparent 0.55rem 1.05rem);
    background-size: 1.05rem 1px;
  }

  .article-prose {
    line-height: 1.9;
    width: 100%;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .article-prose :global(*) {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .article-prose :global(h2),
  .article-prose :global(h3) {
    position: relative;
    padding-left: 1rem;
    letter-spacing: 0;
  }

  .article-prose :global(h2::before),
  .article-prose :global(h3::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.14em;
    bottom: 0.14em;
    width: 0.28rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .article-prose :global(blockquote) {
    border-left: 0;
    border-radius: 1.1rem;
    padding: 1rem 1.2rem;
    background: var(--surface-blue);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    padding-left: 1.25rem;
  }

  @media (max-width: 640px) {
    .article-page {
      padding-left: 1rem;
      padding-right: 1rem;
      width: 100%;
      max-width: 100vw !important;
    }

    .article-hero {
      grid-template-columns: 1fr;
      border-radius: 1.25rem;
      gap: 0.85rem;
      padding: 1.05rem 1rem 1.25rem;
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .article-content {
      width: 100%;
      max-width: 100% !important;
      margin-left: auto;
      margin-right: auto;
    }

    .article-layout {
      width: 100%;
      max-width: 100%;
    }

    .article-hero__icon {
      width: 3.4rem;
      height: 3.4rem;
    }

    .article-hero__title {
      font-size: clamp(1.45rem, 7vw, 1.9rem);
      line-height: 1.18;
    }

    .article-hero__meta {
      gap: 0.45rem 0.75rem;
      font-size: 0.76rem;
    }

    .article-lead {
      font-size: 0.98rem;
      line-height: 1.8;
    }

    .animal-divider--triangles {
      width: min(15rem, 74%);
      background-size: 0.85rem 0.85rem;
    }

    .article-prose {
      font-size: 1rem;
      line-height: 1.95;
    }

    .article-prose :global(h2) {
      font-size: 1.55rem;
      line-height: 1.35;
    }

    .article-prose :global(h3) {
      font-size: 1.28rem;
      line-height: 1.4;
    }

    .article-prose :global(p),
    .article-prose :global(li) {
      word-break: break-word;
    }
  }
</style>
