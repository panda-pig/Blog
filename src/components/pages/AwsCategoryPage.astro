---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import AwsDomainIcon from '../aws/AwsDomainIcon.astro';
import { awsDomains, awsSpecials, awsDomainTopics, getAwsDomain } from '../../data/aws';
import {
  normalizeAwsNotes,
  getLocalizedAwsNotes,
  getAwsNoteHref,
  formatAwsDate,
  getAwsPrefix,
} from '../../lib/aws';
import {
  getAwsUi,
  getAwsDomainCopy,
  getAwsSpecialCopy,
  getAwsTopicLabel,
} from '../../i18n/aws';

const { category } = Astro.params;
const { lang = 'zh' } = Astro.props;
const prefix = getAwsPrefix(lang);
const t = getAwsUi(lang);
const allNoteModules = await Astro.glob('../../content/aws/**/*.md');
const allNotes = normalizeAwsNotes(allNoteModules);
const notes = getLocalizedAwsNotes(allNotes, lang);
const categoryNotes = notes.filter((note: any) => note.frontmatter.category === category);
const domain = getAwsDomain(category || '');
const specialSource = awsSpecials.find((item) => item.slug === category);
const special = specialSource ? getAwsSpecialCopy(specialSource, lang) : undefined;

if (!domain && !special) {
  throw new Error(`AWS category not found: ${category}`);
}

const domainCopy = domain ? getAwsDomainCopy(domain, lang) : undefined;
const title = domain
  ? domainCopy?.localName === domain.name
    ? domain.name
    : `${domain.name} ${domainCopy?.localName}`
  : special!.title;
const description = domainCopy?.description || special!.description;
const icon = domain?.icon || special!.icon;
const tone = domain?.tone || special!.tone;
const topics = awsDomainTopics[category || ''] || [];
const noteByTitle = new Map(
  categoryNotes.map((note: any) => [
    note.frontmatter.topicKey || note.frontmatter.title,
    note,
  ]),
);
---

<BaseLayout
  title={`${title} — ${t.siteTitle}`}
  description={description}
  slug={`${prefix}/aws/${category}`}
  lang={lang}
>
  <Header lang={lang} />

  <main class={`aws-category aws-category--${tone}`} data-pagefind-body>
    <div class="section-container aws-category__container">
      <nav class="aws-breadcrumb" aria-label={t.breadcrumbLabel}>
        <a href={`${prefix}/aws`}>{t.siteTitle}</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>

      <header class="aws-category-hero">
        <div class="aws-category-hero__icon">
          <AwsDomainIcon name={icon} size="lg" />
        </div>
        <div>
          <p>{special ? t.quickReference : t.serviceDomain}</p>
          <h1>{title}</h1>
          <span>{description}</span>
        </div>
        <svg class="aws-category-hero__scribble" viewBox="0 0 160 70" aria-hidden="true">
          <path d="M5 48c18-28 40 22 60-3 16-20 26-35 51-19 11 7 21 5 39-8" />
          <path d="m139 9 16 9-18 5" />
        </svg>
      </header>

      <div class="aws-category-layout">
        <aside class="aws-domain-nav" aria-label={t.domainDirectoryLabel}>
          <p>{t.coreDomains}</p>
          <nav>
            {awsDomains.map((item) => {
              const copy = getAwsDomainCopy(item, lang);
              return (
              <a
                class={item.slug === category ? 'active' : ''}
                href={`${prefix}/aws/${item.slug}`}
                aria-current={item.slug === category ? 'page' : undefined}
              >
                <AwsDomainIcon name={item.icon} size="sm" />
                <span>{copy.localName}</span>
              </a>
            )})}
          </nav>
          <div class="aws-domain-nav__special">
            <p>{t.specialTopics}</p>
            {awsSpecials.map((item) => {
              const copy = getAwsSpecialCopy(item, lang);
              return (
              <a
                class={item.slug === category ? 'active' : ''}
                href={`${prefix}/aws/${item.slug}`}
                aria-current={item.slug === category ? 'page' : undefined}
              >
                <AwsDomainIcon name={item.icon} size="sm" />
                <span>{copy.title}</span>
              </a>
            )})}
          </div>
        </aside>

        <div class="aws-category-main">
          {categoryNotes.length > 0 && (
            <section class="aws-category-section">
              <div class="aws-category-section__heading">
                <div>
                  <p>{t.publicNotes}</p>
                  <h2>{t.knowledgeNotes}</h2>
                </div>
                <span>{t.curatedFromNotion}</span>
              </div>
              <div class="aws-category-note-grid">
                {categoryNotes.map((note: any) => (
                  <a href={getAwsNoteHref(note, lang)} class="aws-category-note">
                    <div class="aws-category-note__meta">
                      <span>{note.frontmatter.service || title}</span>
                      <time datetime={note.frontmatter.updated || note.frontmatter.date}>
                        {formatAwsDate(note.frontmatter.updated || note.frontmatter.date, lang)}
                      </time>
                    </div>
                    <h3>{note.frontmatter.title}</h3>
                    <p>{note.frontmatter.description}</p>
                    <div class="aws-category-note__tags">
                      {(note.frontmatter.tags || []).slice(0, 3).map((tag: string) => <span>{tag}</span>)}
                    </div>
                    <b aria-hidden="true">→</b>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="aws-category-section">
            <div class="aws-category-section__heading">
              <div>
                <p>{t.topicIndex}</p>
                <h2>{special ? t.specialIndex : t.topics}</h2>
              </div>
              <span>{t.topicScope}</span>
            </div>

            <div class="aws-topic-index">
              {topics.map((topic, index) => {
                const note = noteByTitle.get(topic);
                const topicLabel = getAwsTopicLabel(topic, lang);
                return note ? (
                  <a href={getAwsNoteHref(note, lang)}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{topicLabel}</strong>
                    <b>{t.readNote} →</b>
                  </a>
                ) : (
                  <div>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{topicLabel}</strong>
                  </div>
                );
              })}
            </div>
          </section>

          <a class="aws-back-card" href={`${prefix}/aws`}>
            <span>←</span>
            <div>
              <small>{t.backHome}</small>
              <strong>{t.browseOther}</strong>
            </div>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .aws-category {
    --category-color: #4777a7;
    --category-soft: rgba(71, 119, 167, 0.11);
    min-height: 100vh;
    background:
      radial-gradient(circle at 85% 6%, var(--category-soft), transparent 23rem),
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 92%, #fff8ea 8%), var(--bg) 32rem);
  }

  .aws-category--green,
  .aws-category--forest { --category-color: #477a5b; --category-soft: rgba(71, 122, 91, 0.1); }
  .aws-category--orange { --category-color: #d77a00; --category-soft: rgba(240, 138, 0, 0.1); }
  .aws-category--amber { --category-color: #b86f18; --category-soft: rgba(184, 111, 24, 0.11); }
  .aws-category--violet,
  .aws-category--purple { --category-color: #6653ac; --category-soft: rgba(102, 83, 172, 0.1); }
  .aws-category--cyan,
  .aws-category--teal,
  .aws-category--aqua { --category-color: #347989; --category-soft: rgba(52, 121, 137, 0.1); }
  .aws-category--indigo,
  .aws-category--navy,
  .aws-category--royal { --category-color: #426aa1; --category-soft: rgba(66, 106, 161, 0.1); }

  .aws-category__container {
    padding-top: 2.25rem;
    padding-bottom: 6rem;
  }

  .aws-breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .aws-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .aws-breadcrumb a:hover {
    color: var(--category-color);
  }

  .aws-category-hero {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.35rem;
    align-items: center;
    min-height: 12rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--category-color) 20%, var(--border));
    border-radius: 1.5rem;
    color: var(--category-color);
    background:
      radial-gradient(circle at 89% 20%, color-mix(in srgb, var(--category-color) 11%, transparent), transparent 18rem),
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 92%, var(--category-color) 8%), var(--surface));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      0 8px 0 color-mix(in srgb, var(--category-color) 8%, transparent),
      0 23px 52px rgba(52, 70, 100, 0.1);
  }

  .aws-category-hero__icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border: 1px solid color-mix(in srgb, var(--category-color) 22%, var(--border));
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--surface) 92%, var(--category-color) 8%);
    box-shadow: 0 6px 0 color-mix(in srgb, var(--category-color) 11%, transparent);
  }

  .aws-category-hero p,
  .aws-category-section__heading p {
    margin: 0;
    color: var(--category-color);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .aws-category-hero h1 {
    margin: 0.3rem 0 0.55rem;
    color: var(--text);
    font-family: 'Noto Serif', serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .aws-category-hero > div > span {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .aws-category-hero__scribble {
    position: absolute;
    right: 2.2rem;
    bottom: 1.4rem;
    width: 10rem;
    fill: none;
    stroke: var(--category-color);
    stroke-width: 1.3;
    stroke-dasharray: 4 6;
    opacity: 0.23;
  }

  .aws-category-layout {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: 2.4rem;
    align-items: start;
    margin-top: 3rem;
  }

  .aws-domain-nav {
    position: sticky;
    top: 6rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: 0 13px 30px rgba(52, 70, 100, 0.07);
    backdrop-filter: blur(18px);
  }

  .aws-domain-nav > p,
  .aws-domain-nav__special > p {
    margin: 0 0 0.6rem;
    padding: 0 0.6rem;
    color: var(--text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.045em;
  }

  .aws-domain-nav nav,
  .aws-domain-nav__special {
    display: grid;
    gap: 0.12rem;
  }

  .aws-domain-nav__special {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--border);
  }

  .aws-domain-nav a {
    position: relative;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    min-height: 2.55rem;
    padding: 0.48rem 0.6rem;
    border-radius: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .aws-domain-nav a:hover {
    color: var(--text);
    background: var(--surface-hover);
    transform: translateX(2px);
  }

  .aws-domain-nav a.active {
    color: var(--category-color);
    background: color-mix(in srgb, var(--category-color) 12%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--category-color) 18%, transparent);
    font-weight: 700;
  }

  .aws-domain-nav a.active::after {
    content: '';
    width: 0.34rem;
    height: 0.34rem;
    margin-left: auto;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .aws-category-main {
    min-width: 0;
  }

  .aws-category-section + .aws-category-section {
    margin-top: 3.5rem;
  }

  .aws-category-section__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.1rem;
  }

  .aws-category-section__heading h2 {
    margin: 0.22rem 0 0;
    color: var(--text);
    font-family: 'Noto Serif', serif;
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .aws-category-section__heading > span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .aws-category-note-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .aws-category-note {
    position: relative;
    min-height: 13rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    color: var(--text);
    background: var(--surface);
    box-shadow:
      0 5px 0 color-mix(in srgb, var(--category-color) 8%, transparent),
      0 14px 30px rgba(52, 70, 100, 0.08);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .aws-category-note:hover {
    border-color: color-mix(in srgb, var(--category-color) 35%, var(--border));
    box-shadow:
      0 7px 0 color-mix(in srgb, var(--category-color) 11%, transparent),
      0 20px 38px rgba(52, 70, 100, 0.13);
    transform: translateY(-3px);
  }

  .aws-category-note__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
  }

  .aws-category-note__meta span {
    color: var(--category-color);
    font-weight: 600;
  }

  .aws-category-note h3 {
    margin: 0.8rem 0 0;
    font-family: 'Noto Serif', serif;
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .aws-category-note > p {
    margin: 0.55rem 0 0.8rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .aws-category-note__tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .aws-category-note__tags span {
    padding: 0.23rem 0.4rem;
    border-radius: 0.35rem;
    color: var(--text-muted);
    background: var(--surface-alt);
    font-size: 0.62rem;
    line-height: 1.35;
  }

  .aws-category-note > b {
    position: absolute;
    right: 1rem;
    bottom: 0.75rem;
    color: #e98300;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    transition: transform 0.18s ease;
  }

  .aws-category-note:hover > b {
    transform: translateX(4px);
  }

  .aws-topic-index {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 14px 32px rgba(52, 70, 100, 0.07);
  }

  .aws-topic-index > div,
  .aws-topic-index > a {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }

  .aws-topic-index > :first-child {
    border-top: 0;
  }

  .aws-topic-index > a {
    background: linear-gradient(90deg, var(--category-soft), transparent 55%);
    transition: background 0.18s ease, padding-left 0.18s ease;
  }

  .aws-topic-index > a:hover {
    padding-left: 1.2rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--category-color) 15%, transparent), transparent 70%);
  }

  .aws-topic-index span {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
  }

  .aws-topic-index strong {
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .aws-topic-index > div strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .aws-topic-index > a strong {
    color: var(--text);
    font-weight: 700;
  }

  .aws-topic-index b {
    color: var(--category-color);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .aws-back-card {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin-top: 3.5rem;
    padding: 1rem 1.15rem;
    border: 1px dashed color-mix(in srgb, var(--category-color) 35%, var(--border));
    border-radius: 1rem;
    color: var(--text);
    background: var(--category-soft);
    text-decoration: none;
  }

  .aws-back-card > span {
    color: var(--category-color);
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem;
  }

  .aws-back-card div {
    display: grid;
    gap: 0.1rem;
  }

  .aws-back-card small {
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .aws-back-card strong {
    font-size: 0.84rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .aws-category-layout {
      grid-template-columns: 1fr;
    }

    .aws-domain-nav {
      position: static;
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      padding: 0.55rem;
      scrollbar-width: none;
    }

    .aws-domain-nav::-webkit-scrollbar {
      display: none;
    }

    .aws-domain-nav > p,
    .aws-domain-nav__special > p {
      display: none;
    }

    .aws-domain-nav nav,
    .aws-domain-nav__special {
      display: flex;
      gap: 0.2rem;
    }

    .aws-domain-nav__special {
      margin: 0;
      padding: 0 0 0 0.35rem;
      border-top: 0;
      border-left: 1px dashed var(--border);
    }

    .aws-domain-nav a {
      min-width: max-content;
      min-height: 2.75rem;
    }
  }

  @media (max-width: 640px) {
    .aws-category__container {
      padding: 1.2rem 1rem 4rem;
    }

    .aws-category-hero {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .aws-category-hero__icon {
      width: 4rem;
      height: 4rem;
    }

    .aws-category-hero__scribble {
      right: -1rem;
      bottom: 0.5rem;
    }

    .aws-category-layout {
      margin-top: 1.7rem;
      gap: 1.8rem;
    }

    .aws-breadcrumb a {
      display: inline-flex;
      align-items: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      justify-content: center;
    }

    .aws-category-note-grid {
      grid-template-columns: 1fr;
    }

    .aws-category-section__heading {
      align-items: start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .aws-topic-index > div,
    .aws-topic-index > a {
      grid-template-columns: 1.8rem minmax(0, 1fr);
    }

    .aws-topic-index b {
      display: none;
    }
  }
</style>
