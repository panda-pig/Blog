---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { momentsData } from '../../data/moments';
import dict from '../../i18n/dict.js';

const { lang } = Astro.props;
const moments = momentsData[lang as 'zh' | 'en' | 'ja'] || momentsData.zh;
const t = dict[lang] || dict.zh;

function formatTimelineDate(dateStr: string, locale: string) {
  const d = new Date(dateStr);
  const m = d.getMonth() + 1;
  const day = d.getDate();
  if (locale === 'en-US') {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return { month: months[d.getMonth()], day: day.toString() };
  }
  return { month: `${m}月`, day: `${day}日` };
}

function formatYear(dateStr: string) {
  return new Date(dateStr).getFullYear().toString();
}

const localeStr = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';

let lastYear = '';
---

<BaseLayout title={`${t['moments.title']} — Panda Blog`} description={t['moments.desc']} lang={lang}>
  <Header lang={lang} />

  <main class="moments-page">
    <div class="moments-container">
      <!-- Page header -->
      <div class="moments-header">
        <h1 class="moments-title">
          <span class="moments-title-ribbon">
            <span class="moments-title-ribbon__back moments-title-ribbon__back--left" aria-hidden="true"></span>
            <span class="moments-title-ribbon__back moments-title-ribbon__back--right" aria-hidden="true"></span>
            <span class="moments-title-ribbon__fold moments-title-ribbon__fold--left" aria-hidden="true"></span>
            <span class="moments-title-ribbon__fold moments-title-ribbon__fold--right" aria-hidden="true"></span>
            <span class="moments-title-ribbon__front" aria-hidden="true"></span>
            <span class="moments-title-ribbon__text">{t['moments.title']}</span>
          </span>
        </h1>
        <p class="moments-subtitle">{t['moments.desc']}</p>
        <div class="moments-divider" aria-hidden="true"></div>
      </div>

      <!-- Timeline + Feed -->
      <div class="timeline">
        {moments.map((moment, index) => {
          const td = formatTimelineDate(moment.date, localeStr);
          const year = formatYear(moment.date);
          const showYear = year !== lastYear;
          lastYear = year;
          const isLast = index === moments.length - 1;

          return (
            <div class="tl-row">
              {/* Left: timeline axis */}
              <div class="tl-axis">
                {showYear && (
                  <div class="tl-year">{year}</div>
                )}
                <div class="tl-date">
                  <span class="tl-month">{td.month}</span>
                  <span class="tl-day">{td.day}</span>
                </div>
                <div class="tl-dot"></div>
                {!isLast && <div class="tl-line"></div>}
              </div>

              {/* Right: feed card */}
              <div class="tl-content">
                <article class="feed-card">
                  <!-- Header: avatar + identity -->
                  <div class="feed-card-header">
                    <div class="feed-avatar">
                    <img src="/images/avatar.jpg" alt="Panda" class="w-full h-full object-cover" />
                  </div>
                    <div class="feed-identity">
                      <div class="feed-name">Panda</div>
                      <div class="feed-meta">
                        <span>@panda</span>
                        <span class="feed-dot">·</span>
                        <span>{moment.location}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Body -->
                  <div class="feed-body">
                    <h3 class="feed-title">{moment.title}</h3>
                    <p class="feed-text">{moment.content}</p>
                  </div>

                  <!-- Images -->
                  {moment.images && moment.images.length > 0 && (
                    <div class="feed-images">
                      {moment.images.map((img: string) => (
                        <a href={img} target="_blank" class="feed-image-link">
                          <img
                            src={img}
                            alt={moment.title}
                            class="feed-image"
                            loading="lazy"
                          />
                        </a>
                      ))}
                    </div>
                  )}

                  <!-- Tags -->
                  <div class="feed-tags">
                    {moment.tags.map((tag: string) => (
                      <span class="feed-tag">#{tag}</span>
                    ))}
                  </div>

                </article>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .moments-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 16% 8%, rgba(215, 231, 246, 0.52), transparent 24rem),
      radial-gradient(circle at 84% 18%, rgba(255, 133, 98, 0.08), transparent 18rem),
      #F5F1EB;
    overflow-x: clip;
    padding-bottom: 80px;
  }

  [data-theme="dark"] .moments-page {
    background:
      radial-gradient(circle at 16% 8%, rgba(129, 174, 217, 0.12), transparent 24rem),
      #16181c;
  }

  .moments-container {
    width: 100%;
    max-width: 960px;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Page header */
  .moments-header {
    text-align: center;
    padding: 64px 0 42px;
  }

  .moments-title {
    display: inline-block;
    margin: 0 0 1.15rem;
    font-family: 'Noto Sans', sans-serif;
    font-size: clamp(1.55rem, 4vw, 2.5rem);
    font-weight: 900;
    line-height: 1;
    user-select: none;
  }

  .moments-title-ribbon {
    --rf: #FADDE8;
    --rb: #F4AFC7;
    --rk: #D47F9B;
    --rt: var(--text);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.78em;
    padding: 0 1.35em;
    color: var(--rt);
    white-space: nowrap;
    filter: drop-shadow(0 0.08em 0.12em rgba(82, 111, 164, 0.1));
  }

  [data-theme="dark"] .moments-title-ribbon {
    --rf: rgba(244, 175, 199, 0.24);
    --rb: rgba(244, 175, 199, 0.18);
    --rk: rgba(244, 175, 199, 0.34);
    --rt: var(--text);
  }

  .moments-title-ribbon__text {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    height: 1.78em;
    padding-top: 0.1em;
    color: var(--rt);
  }

  .moments-title-ribbon__back {
    position: absolute;
    bottom: -0.3em;
    width: 1.36em;
    height: 1.36em;
    background: var(--rb);
    z-index: 1;
  }

  .moments-title-ribbon__back--left {
    left: -0.48em;
    border-radius: 0.08em 0 0 0.08em;
    clip-path: polygon(100% 0%, 100% 100%, 0% 100%, 30% 50%, 0% 0%);
  }

  .moments-title-ribbon__back--right {
    right: -0.48em;
    border-radius: 0 0.08em 0.08em 0;
    clip-path: polygon(0% 0%, 100% 0%, 70% 50%, 100% 100%, 0% 100%);
  }

  .moments-title-ribbon__fold {
    position: absolute;
    top: calc(100% - 0.04em);
    width: 0;
    height: 0;
    border-style: solid;
    z-index: 2;
  }

  .moments-title-ribbon__fold--left {
    left: 0.14em;
    border-width: 0 0.72em 0.3em 0;
    border-color: transparent var(--rk) transparent transparent;
  }

  .moments-title-ribbon__fold--right {
    right: 0.14em;
    border-width: 0 0 0.3em 0.72em;
    border-color: transparent transparent transparent var(--rk);
  }

  .moments-title-ribbon__front {
    position: absolute;
    inset: 0 0.1em;
    z-index: 3;
    border-radius: 0.22em;
    background: var(--rf);
    box-shadow: inset 0 -0.06em rgba(31, 42, 61, 0.06);
    pointer-events: none;
    transform: perspective(11.5em) rotateX(3deg);
  }

  .moments-subtitle {
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.45);
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto 1.05rem;
  }

  [data-theme="dark"] .moments-subtitle {
    color: rgba(255, 253, 245, 0.42);
  }

  .moments-divider {
    width: min(16rem, 64%);
    height: 0.75rem;
    margin: 0 auto;
    background:
      radial-gradient(circle at 0.4rem 50%, var(--surface-blue) 0 0.2rem, transparent 0.22rem) 0 0 / 1.05rem 100% repeat-x;
    opacity: 0.85;
  }

  /* Timeline */
  .timeline {
    position: relative;
  }

  .tl-row {
    display: flex;
    gap: 0;
  }

  .tl-row:last-child .tl-content {
    padding-bottom: 0;
  }

  /* Timeline axis (left) */
  .tl-axis {
    width: 100px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 24px;
    position: relative;
  }

  .tl-year {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.16rem 0.5rem;
    border: 1px dashed var(--accent-border);
    border-radius: 999px;
    background: var(--primary-light);
    color: var(--primary);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.42rem;
  }

  [data-theme="dark"] .tl-year {
    color: var(--text-secondary);
  }

  .tl-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
    padding: 0.48rem 0.56rem;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.64);
    box-shadow: inset 0 -2px rgba(31, 42, 61, 0.04);
  }

  [data-theme="dark"] .tl-date {
    background: rgba(255, 253, 245, 0.06);
  }

  .tl-month {
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    font-weight: 500;
  }

  [data-theme="dark"] .tl-month {
    color: rgba(255, 253, 245, 0.36);
  }

  .tl-day {
    font-size: 1.35rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.55);
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    letter-spacing: -0.02em;
  }

  [data-theme="dark"] .tl-day {
    color: rgba(255, 253, 245, 0.5);
  }

  .tl-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent-warm);
    border: 3px solid #F5F1EB;
    position: absolute;
    right: -6.5px;
    top: 10px;
    z-index: 2;
    box-shadow: 0 0 0 5px rgba(255, 133, 98, 0.14);
  }

  [data-theme="dark"] .tl-dot {
    border-color: #16181c;
    background: var(--accent-warm);
    box-shadow: 0 0 0 5px rgba(255, 183, 132, 0.11);
  }

  .tl-line {
    flex: 1;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-border) 0 45%, transparent 45% 100%) 0 0 / 100% 12px repeat-y;
    margin-top: 18px;
    min-height: 24px;
  }

  [data-theme="dark"] .tl-line {
    background: linear-gradient(to bottom, rgba(129, 174, 217, 0.28) 0 45%, transparent 45% 100%) 0 0 / 100% 12px repeat-y;
  }

  /* Timeline content (right) */
  .tl-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 40px;
  }

  /* Feed card */
  .feed-card {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 100% 0%, rgba(215, 231, 246, 0.55), transparent 11rem),
      #ffffff;
    border: 1px solid var(--border);
    border-radius: 1.35rem;
    padding: 1.35rem 1.45rem 1.55rem;
    box-shadow: 0 13px 32px rgba(31, 42, 61, 0.08), 0 4px 0 rgba(31, 42, 61, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .feed-card::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0.46rem;
    height: 0.42rem;
    background:
      radial-gradient(circle, var(--surface-blue) 0 0.2rem, transparent 0.22rem) 0 0 / 1rem 100% repeat-x;
    opacity: 0.6;
    pointer-events: none;
  }

  .feed-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow: 0 18px 36px rgba(31, 42, 61, 0.12), 0 5px 0 rgba(31, 42, 61, 0.07);
  }

  [data-theme="dark"] .feed-card {
    background:
      radial-gradient(circle at 100% 0%, rgba(129, 174, 217, 0.14), transparent 11rem),
      #24272b;
    border-color: rgba(255, 255, 255, 0.11);
    box-shadow: 0 13px 32px rgba(0, 0, 0, 0.26), 0 4px 0 rgba(0, 0, 0, 0.18);
  }

  [data-theme="dark"] .feed-card:hover {
    border-color: rgba(129, 174, 217, 0.34);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.34), 0 5px 0 rgba(0, 0, 0, 0.2);
  }

  /* Card header */
  .feed-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .feed-avatar {
    width: 40px;
    height: 40px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 5px 12px rgba(31, 42, 61, 0.1);
  }

  .feed-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feed-identity {
    min-width: 0;
  }

  .feed-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }

  [data-theme="dark"] .feed-name {
    color: #fffdf5;
  }

  .feed-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }

  [data-theme="dark"] .feed-meta {
    color: rgba(255, 253, 245, 0.38);
  }

  .feed-dot {
    opacity: 0.35;
  }

  /* Card body */
  .feed-body {
    margin-bottom: 16px;
  }

  .feed-title {
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    font-size: 1.12rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.42rem;
    line-height: 1.5;
  }

  [data-theme="dark"] .feed-title {
    color: #fffdf5;
  }

  .feed-text {
    font-size: 0.9rem;
    line-height: 1.85;
    color: rgba(0, 0, 0, 0.65);
    overflow-wrap: anywhere;
  }

  [data-theme="dark"] .feed-text {
    color: rgba(255, 253, 245, 0.6);
  }

  /* Images - 3-column square grid */
  .feed-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .feed-image-link {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    cursor: pointer;
    box-shadow: 0 5px 14px rgba(31, 42, 61, 0.08);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .feed-image-link:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .feed-image-link:only-child {
    max-width: 18rem;
  }

  .feed-images:has(.feed-image-link:only-child) {
    grid-template-columns: minmax(0, 18rem);
  }

  .feed-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Tags */
  .feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--accent-border);
    margin-bottom: 0.4rem;
  }

  .feed-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #2F6F64;
    border: 1px dashed rgba(47, 111, 100, 0.22);
    background: rgba(47, 111, 100, 0.08);
    font-weight: 700;
  }

  [data-theme="dark"] .feed-tag {
    color: #7EC8B8;
    border-color: rgba(126, 200, 184, 0.2);
    background: rgba(126, 200, 184, 0.1);
  }

  /* Mobile */
  @media (max-width: 640px) {
    .moments-container {
      padding: 0 14px 0 8px;
    }

    .tl-row {
      display: block;
    }

    .moments-header {
      padding: 40px 0 32px;
    }

    .moments-title {
      font-size: clamp(1.35rem, 8vw, 2rem);
    }

    .moments-subtitle {
      font-size: 0.82rem;
      max-width: 280px;
    }

    .tl-axis {
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 0.45rem;
      padding: 0 0 0.65rem 0;
    }

    .tl-month {
      font-size: 0.68rem;
    }

    .tl-day {
      font-size: 1.15rem;
    }

    .tl-year {
      font-size: 0.65rem;
      padding: 0.12rem 0.42rem;
      margin-bottom: 0;
    }

    .tl-dot {
      position: static;
      width: 10px;
      height: 10px;
      border-width: 2px;
      box-shadow: 0 0 0 3px rgba(255, 133, 98, 0.14);
    }

    .tl-date {
      flex-direction: row;
      align-items: center;
      gap: 0.18rem;
      padding: 0.4rem 0.46rem;
      border-radius: 0.7rem;
    }

    .tl-line {
      display: none;
    }

    .tl-content {
      min-width: 0;
      width: calc(100vw - 56px);
      max-width: calc(100vw - 56px);
      padding-bottom: 32px;
    }

    .feed-card {
      width: calc(100vw - 56px);
      max-width: calc(100vw - 56px);
      box-sizing: border-box;
      border-radius: 1.1rem;
      padding: 1rem 0.95rem 1.2rem;
    }

    .feed-card-header {
      gap: 8px;
    }

    .feed-card::after {
      left: 0.85rem;
      right: 0.85rem;
      bottom: 0.38rem;
    }

    .feed-avatar {
      width: 34px;
      height: 34px;
      border-radius: 10px;
    }

    .feed-name {
      font-size: 0.85rem;
    }

    .feed-meta {
      font-size: 0.7rem;
    }

    .feed-title {
      font-size: 1rem;
      overflow-wrap: anywhere;
    }

    .feed-text {
      font-size: 0.85rem;
    }

    .feed-images {
      gap: 3px;
    }

    .feed-image-link {
      border-radius: 8px;
    }

    .feed-image-link:only-child {
      max-width: 10rem;
    }

    .feed-images:has(.feed-image-link:only-child) {
      grid-template-columns: minmax(0, 10rem);
    }

    .feed-tag {
      font-size: 0.72rem;
      padding: 2px 7px;
    }

  }
</style>
