---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { momentsData } from '../../data/moments';
import dict from '../../i18n/dict.js';

const { lang } = Astro.props;
const moments = momentsData[lang as 'zh' | 'en' | 'ja'] || momentsData.zh;
const t = dict[lang] || dict.zh;

function formatTimelineDate(dateStr: string, locale: string) {
  const d = new Date(dateStr);
  const m = d.getMonth() + 1;
  const day = d.getDate();
  if (locale === 'en-US') {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return { month: months[d.getMonth()], day: day.toString() };
  }
  return { month: `${m}月`, day: `${day}日` };
}

function formatYear(dateStr: string) {
  return new Date(dateStr).getFullYear().toString();
}

const localeStr = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';
const interactionLabels = {
  'zh-CN': { like: '喜欢', comment: '评论', share: '分享' },
  'en-US': { like: 'Likes', comment: 'Comments', share: 'Share' },
  'ja-JP': { like: 'いいね', comment: 'コメント', share: 'シェア' },
};
const il = interactionLabels[localeStr] || interactionLabels['zh-CN'];

let lastYear = '';
---

<BaseLayout title={`${t['moments.title']} — Panda Blog`} description={t['moments.desc']} lang={lang}>
  <Header lang={lang} />

  <main class="moments-page">
    <div class="moments-container">
      <!-- Page header -->
      <div class="moments-header">
        <h1 class="moments-title">{t['moments.title']}</h1>
        <p class="moments-subtitle">{t['moments.desc']}</p>
      </div>

      <!-- Timeline + Feed -->
      <div class="timeline">
        {moments.map((moment, index) => {
          const td = formatTimelineDate(moment.date, localeStr);
          const year = formatYear(moment.date);
          const showYear = year !== lastYear;
          lastYear = year;
          const isLast = index === moments.length - 1;

          return (
            <div class="tl-row">
              {/* Left: timeline axis */}
              <div class="tl-axis">
                {showYear && (
                  <div class="tl-year">{year}</div>
                )}
                <div class="tl-date">
                  <span class="tl-month">{td.month}</span>
                  <span class="tl-day">{td.day}</span>
                </div>
                <div class="tl-dot"></div>
                {!isLast && <div class="tl-line"></div>}
              </div>

              {/* Right: feed card */}
              <div class="tl-content">
                <article class="feed-card">
                  <!-- Header: avatar + identity -->
                  <div class="feed-card-header">
                    <div class="feed-avatar">P</div>
                    <div class="feed-identity">
                      <div class="feed-name">Panda</div>
                      <div class="feed-meta">
                        <span>@panda</span>
                        <span class="feed-dot">·</span>
                        <span>{moment.location}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Body -->
                  <div class="feed-body">
                    <h3 class="feed-title">{moment.title}</h3>
                    <p class="feed-text">{moment.content}</p>
                  </div>

                  <!-- Images -->
                  {moment.images && moment.images.length > 0 && (
                    <div class={`feed-images grid-${moment.images.length >= 3 ? '3' : moment.images.length === 2 ? '2' : '1'}`}>
                      {moment.images.map((img: string) => (
                        <div class="feed-image-placeholder">
                          <img
                            src={img}
                            alt={moment.title}
                            class="feed-image"
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />
                        </div>
                      ))}
                    </div>
                  )}

                  {/* Placeholder gradients for posts without images */}
                  {(!moment.images || moment.images.length === 0) && (
                    <div class="feed-images grid-3">
                      <div class="feed-image-placeholder" style="background: linear-gradient(135deg, #DDEFE7, #C8DFD6);"></div>
                      <div class="feed-image-placeholder" style="background: linear-gradient(135deg, #F7E7C6, #E8D5B0);"></div>
                      <div class="feed-image-placeholder" style="background: linear-gradient(135deg, #D4E7F7, #B8D4E8);"></div>
                    </div>
                  )}

                  <!-- Tags -->
                  <div class="feed-tags">
                    {moment.tags.map((tag: string) => (
                      <span class="feed-tag">#{tag}</span>
                    ))}
                  </div>

                  <!-- Interaction bar -->
                  <div class="feed-actions">
                    <span class="feed-action">
                      <svg class="feed-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
                      </svg>
                      {moment.likes}
                    </span>
                    <span class="feed-action">
                      <svg class="feed-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                      </svg>
                      {moment.comments}
                    </span>
                    <span class="feed-action feed-action-share">
                      <svg class="feed-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
                      </svg>
                      {il.share}
                    </span>
                  </div>
                </article>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .moments-page {
    min-height: 100vh;
    background: #FAF8F3;
    padding-bottom: 80px;
  }

  [data-theme="dark"] .moments-page {
    background: #1a1d21;
  }

  .moments-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Page header */
  .moments-header {
    text-align: center;
    padding: 64px 0 48px;
  }

  .moments-title {
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  [data-theme="dark"] .moments-title {
    color: #fffdf5;
  }

  .moments-subtitle {
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.45);
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto;
  }

  [data-theme="dark"] .moments-subtitle {
    color: rgba(255, 253, 245, 0.42);
  }

  /* Timeline */
  .timeline {
    position: relative;
  }

  .tl-row {
    display: flex;
    gap: 0;
  }

  .tl-row:last-child .tl-content {
    padding-bottom: 0;
  }

  /* Timeline axis (left) */
  .tl-axis {
    width: 84px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 20px;
    position: relative;
  }

  .tl-year {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.3);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  [data-theme="dark"] .tl-year {
    color: rgba(255, 253, 245, 0.28);
  }

  .tl-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
  }

  .tl-month {
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    font-weight: 500;
  }

  [data-theme="dark"] .tl-month {
    color: rgba(255, 253, 245, 0.36);
  }

  .tl-day {
    font-size: 1.35rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.55);
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    letter-spacing: -0.02em;
  }

  [data-theme="dark"] .tl-day {
    color: rgba(255, 253, 245, 0.5);
  }

  .tl-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #A7C7E7;
    border: 2px solid #FAF8F3;
    position: absolute;
    right: -4.5px;
    top: 4px;
    z-index: 2;
    box-shadow: 0 0 0 0px rgba(167, 199, 231, 0);
  }

  [data-theme="dark"] .tl-dot {
    border-color: #1a1d21;
    background: #6a9cc4;
  }

  .tl-line {
    flex: 1;
    width: 1px;
    background: rgba(0, 0, 0, 0.08);
    margin-top: 12px;
    min-height: 24px;
  }

  [data-theme="dark"] .tl-line {
    background: rgba(255, 255, 255, 0.07);
  }

  /* Timeline content (right) */
  .tl-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 40px;
  }

  /* Feed card */
  .feed-card {
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(20, 20, 20, 0.08);
    border-radius: 20px;
    padding: 24px 26px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.035);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.055);
  }

  [data-theme="dark"] .feed-card {
    background: rgba(36, 39, 43, 0.92);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .feed-card:hover {
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.32);
  }

  /* Card header */
  .feed-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .feed-avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #A7C7E7;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
  }

  .feed-identity {
    min-width: 0;
  }

  .feed-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }

  [data-theme="dark"] .feed-name {
    color: #fffdf5;
  }

  .feed-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }

  [data-theme="dark"] .feed-meta {
    color: rgba(255, 253, 245, 0.38);
  }

  .feed-dot {
    opacity: 0.35;
  }

  /* Card body */
  .feed-body {
    margin-bottom: 16px;
  }

  .feed-title {
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    font-size: 1.08rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 6px;
    line-height: 1.5;
  }

  [data-theme="dark"] .feed-title {
    color: #fffdf5;
  }

  .feed-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: rgba(0, 0, 0, 0.65);
  }

  [data-theme="dark"] .feed-text {
    color: rgba(255, 253, 245, 0.6);
  }

  /* Images */
  .feed-images {
    display: grid;
    gap: 7px;
    margin-bottom: 16px;
  }

  .feed-images.grid-1 {
    grid-template-columns: 1fr;
  }

  .feed-images.grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .feed-images.grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .feed-image-placeholder {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, #DDEFE7, #F7E7C6);
  }

  .feed-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Tags */
  .feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 14px;
  }

  .feed-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #2F6F64;
    background: rgba(47, 111, 100, 0.08);
    font-weight: 500;
  }

  [data-theme="dark"] .feed-tag {
    color: #7EC8B8;
    background: rgba(126, 200, 184, 0.1);
  }

  /* Interaction bar */
  .feed-actions {
    display: flex;
    gap: 18px;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  [data-theme="dark"] .feed-actions {
    border-top-color: rgba(255, 255, 255, 0.05);
  }

  .feed-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: rgba(0, 0, 0, 0.4);
    font-size: 0.82rem;
    cursor: default;
    user-select: none;
  }

  [data-theme="dark"] .feed-action {
    color: rgba(255, 253, 245, 0.38);
  }

  .feed-action-icon {
    width: 15px;
    height: 15px;
    opacity: 0.55;
  }

  .feed-action-share {
    margin-left: auto;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .moments-container {
      padding: 0 12px;
    }

    .moments-header {
      padding: 40px 0 32px;
    }

    .moments-title {
      font-size: 1.75rem;
    }

    .moments-subtitle {
      font-size: 0.82rem;
      max-width: 280px;
    }

    .tl-axis {
      width: 56px;
      padding-right: 12px;
    }

    .tl-month {
      font-size: 0.68rem;
    }

    .tl-day {
      font-size: 1.15rem;
    }

    .tl-year {
      font-size: 0.65rem;
    }

    .tl-dot {
      width: 7px;
      height: 7px;
      right: -3.5px;
      top: 3px;
    }

    .tl-content {
      padding-bottom: 32px;
    }

    .feed-card {
      border-radius: 16px;
      padding: 18px 16px;
    }

    .feed-avatar {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      font-size: 0.85rem;
    }

    .feed-name {
      font-size: 0.85rem;
    }

    .feed-title {
      font-size: 1rem;
    }

    .feed-text {
      font-size: 0.85rem;
    }

    .feed-images {
      gap: 5px;
    }

    .feed-image-placeholder {
      border-radius: 8px;
    }

    .feed-tag {
      font-size: 0.72rem;
      padding: 2px 7px;
    }

    .feed-actions {
      gap: 12px;
    }

    .feed-action {
      font-size: 0.78rem;
    }
  }
</style>
