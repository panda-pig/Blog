---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { momentsData } from '../../data/moments';
import dict from '../../i18n/dict.js';

const { lang } = Astro.props;
const moments = momentsData[lang as 'zh' | 'en' | 'ja'] || momentsData.zh;
const t = dict[lang] || dict.zh;

function formatTimelineDate(dateStr: string, locale: string) {
  const d = new Date(dateStr);
  const m = d.getMonth() + 1;
  const day = d.getDate();
  if (locale === 'en-US') {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return { month: months[d.getMonth()], day: day.toString() };
  }
  return { month: `${m}月`, day: `${day}日` };
}

function formatYear(dateStr: string) {
  return new Date(dateStr).getFullYear().toString();
}

const localeStr = lang === 'zh' ? 'zh-CN' : lang === 'ja' ? 'ja-JP' : 'en-US';

let lastYear = '';
---

<BaseLayout title={`${t['moments.title']} — Panda Blog`} description={t['moments.desc']} lang={lang}>
  <Header lang={lang} />

  <main class="moments-page">
    <div class="moments-container">
      <!-- Page header -->
      <div class="moments-header">
        <h1 class="moments-title">{t['moments.title']}</h1>
        <p class="moments-subtitle">{t['moments.desc']}</p>
      </div>

      <!-- Timeline + Feed -->
      <div class="timeline">
        {moments.map((moment, index) => {
          const td = formatTimelineDate(moment.date, localeStr);
          const year = formatYear(moment.date);
          const showYear = year !== lastYear;
          lastYear = year;
          const isLast = index === moments.length - 1;

          return (
            <div class="tl-row">
              {/* Left: timeline axis */}
              <div class="tl-axis">
                {showYear && (
                  <div class="tl-year">{year}</div>
                )}
                <div class="tl-date">
                  <span class="tl-month">{td.month}</span>
                  <span class="tl-day">{td.day}</span>
                </div>
                <div class="tl-dot"></div>
                {!isLast && <div class="tl-line"></div>}
              </div>

              {/* Right: feed card */}
              <div class="tl-content">
                <article class="feed-card">
                  <!-- Header: avatar + identity -->
                  <div class="feed-card-header">
                    <div class="feed-avatar">
                    <img src="/images/avatar.jpg" alt="Panda" class="w-full h-full object-cover" />
                  </div>
                    <div class="feed-identity">
                      <div class="feed-name">Panda</div>
                      <div class="feed-meta">
                        <span>@panda</span>
                        <span class="feed-dot">·</span>
                        <span>{moment.location}</span>
                      </div>
                    </div>
                  </div>

                  <!-- Images -->
                  {moment.images && moment.images.length > 0 && (
                    <div class="feed-images">
                      {moment.images.map((img: string) => (
                        <a href={img} target="_blank" class="feed-image-link">
                          <img
                            src={img}
                            alt={moment.title}
                            class="feed-image"
                            loading="lazy"
                          />
                        </a>
                      ))}
                    </div>
                  )}

                  <!-- Body -->
                  <div class="feed-body">
                    <h3 class="feed-title">{moment.title}</h3>
                    <p class="feed-text">{moment.content}</p>
                  </div>

                  <!-- Tags -->
                  <div class="feed-tags">
                    {moment.tags.map((tag: string) => (
                      <span class="feed-tag">#{tag}</span>
                    ))}
                  </div>

                </article>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .moments-page {
    min-height: 100vh;
    background: #F5F1EB;
    padding-bottom: 80px;
  }

  [data-theme="dark"] .moments-page {
    background: #16181c;
  }

  .moments-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Page header */
  .moments-header {
    text-align: center;
    padding: 64px 0 48px;
  }

  .moments-title {
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  [data-theme="dark"] .moments-title {
    color: #fffdf5;
  }

  .moments-subtitle {
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.45);
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto;
  }

  [data-theme="dark"] .moments-subtitle {
    color: rgba(255, 253, 245, 0.42);
  }

  /* Timeline */
  .timeline {
    position: relative;
  }

  .tl-row {
    display: flex;
    gap: 0;
  }

  .tl-row:last-child .tl-content {
    padding-bottom: 0;
  }

  /* Timeline axis (left) */
  .tl-axis {
    width: 100px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 24px;
    position: relative;
  }

  .tl-year {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.3);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  [data-theme="dark"] .tl-year {
    color: rgba(255, 253, 245, 0.28);
  }

  .tl-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
  }

  .tl-month {
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    font-weight: 500;
  }

  [data-theme="dark"] .tl-month {
    color: rgba(255, 253, 245, 0.36);
  }

  .tl-day {
    font-size: 1.35rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.55);
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    letter-spacing: -0.02em;
  }

  [data-theme="dark"] .tl-day {
    color: rgba(255, 253, 245, 0.5);
  }

  .tl-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #A7C7E7;
    border: 2px solid #F5F1EB;
    position: absolute;
    right: -4.5px;
    top: 4px;
    z-index: 2;
  }

  [data-theme="dark"] .tl-dot {
    border-color: #16181c;
    background: #6a9cc4;
  }

  .tl-line {
    flex: 1;
    width: 1px;
    background: rgba(0, 0, 0, 0.1);
    margin-top: 12px;
    min-height: 24px;
  }

  [data-theme="dark"] .tl-line {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Timeline content (right) */
  .tl-content {
    flex: 1;
    min-width: 0;
    padding-bottom: 40px;
  }

  /* Feed card */
  .feed-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 20px;
    padding: 24px 26px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  [data-theme="dark"] .feed-card {
    background: #24272b;
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  [data-theme="dark"] .feed-card:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }

  /* Card header */
  .feed-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .feed-avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .feed-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feed-identity {
    min-width: 0;
  }

  .feed-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }

  [data-theme="dark"] .feed-name {
    color: #fffdf5;
  }

  .feed-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }

  [data-theme="dark"] .feed-meta {
    color: rgba(255, 253, 245, 0.38);
  }

  .feed-dot {
    opacity: 0.35;
  }

  /* Card body */
  .feed-body {
    margin-bottom: 16px;
  }

  .feed-title {
    font-family: 'Noto Serif', 'Noto Serif SC', serif;
    font-size: 1.08rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 6px;
    line-height: 1.5;
  }

  [data-theme="dark"] .feed-title {
    color: #fffdf5;
  }

  .feed-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: rgba(0, 0, 0, 0.65);
  }

  [data-theme="dark"] .feed-text {
    color: rgba(255, 253, 245, 0.6);
  }

  /* Images - 3-column square grid */
  .feed-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-bottom: 16px;
  }

  .feed-image-link {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .feed-image-link:hover {
    opacity: 0.9;
  }

  .feed-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Tags */
  .feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 14px;
  }

  .feed-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #2F6F64;
    background: rgba(47, 111, 100, 0.08);
    font-weight: 500;
  }

  [data-theme="dark"] .feed-tag {
    color: #7EC8B8;
    background: rgba(126, 200, 184, 0.1);
  }

  /* Mobile */
  @media (max-width: 640px) {
    .moments-container {
      padding: 0 12px;
    }

    .moments-header {
      padding: 40px 0 32px;
    }

    .moments-title {
      font-size: 1.75rem;
    }

    .moments-subtitle {
      font-size: 0.82rem;
      max-width: 280px;
    }

    .tl-axis {
      width: 56px;
      padding-right: 12px;
    }

    .tl-month {
      font-size: 0.68rem;
    }

    .tl-day {
      font-size: 1.15rem;
    }

    .tl-year {
      font-size: 0.65rem;
    }

    .tl-dot {
      width: 7px;
      height: 7px;
      right: -3.5px;
      top: 3px;
    }

    .tl-content {
      padding-bottom: 32px;
    }

    .feed-card {
      border-radius: 16px;
      padding: 18px 16px;
    }

    .feed-avatar {
      width: 34px;
      height: 34px;
      border-radius: 10px;
    }

    .feed-name {
      font-size: 0.85rem;
    }

    .feed-title {
      font-size: 1rem;
    }

    .feed-text {
      font-size: 0.85rem;
    }

    .feed-images {
      gap: 3px;
    }

    .feed-image-link {
      border-radius: 8px;
    }

    .feed-tag {
      font-size: 0.72rem;
      padding: 2px 7px;
    }

  }
</style>
