---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const { lang } = Astro.props;
---

<BaseLayout title="通讯 — Panda Lab" description="联系 panda-pig。" lang={lang}>
  <Header lang={lang} />

  <main class="min-h-screen">
    <div class="section-container pt-10 pb-20 max-w-xl">
      <h1 class="font-serif text-3xl md:text-4xl mb-4" style="color: var(--text);" data-i18n="contact.title">通讯</h1>
      <p class="mb-10" style="color: var(--text-secondary);" data-i18n="contact.desc">有任何问题或合作意向？欢迎随时联系我。</p>

      <div class="card-fluid p-8">
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('表单提交功能即将上线！');">
          <div>
            <label for="name" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text);" data-i18n="contact.name">姓名</label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 rounded-lg text-sm transition-all focus:outline-none focus:ring-2"
              style="background-color: var(--surface); border: 1px solid var(--border); color: var(--text); --tw-ring-color: var(--primary);"
              placeholder="你的名字"
              data-i18n-placeholder="contact.placeholderName"
              required
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text);" data-i18n="contact.email">邮箱</label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full px-4 py-3 rounded-lg text-sm transition-all focus:outline-none focus:ring-2"
              style="background-color: var(--surface); border: 1px solid var(--border); color: var(--text); --tw-ring-color: var(--primary);"
              placeholder="your@email.com"
              data-i18n-placeholder="contact.placeholderEmail"
              required
            />
          </div>
          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text);" data-i18n="contact.msg">留言</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full px-4 py-3 rounded-lg text-sm transition-all focus:outline-none focus:ring-2 resize-none"
              style="background-color: var(--surface); border: 1px solid var(--border); color: var(--text); --tw-ring-color: var(--primary);"
              placeholder="你想说什么..."
              data-i18n-placeholder="contact.placeholderMsg"
              required
            ></textarea>
          </div>
          <button type="submit" class="btn-primary w-full" data-i18n="contact.send">发送消息</button>
        </form>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-6 text-sm" style="color: var(--text-secondary);">
        <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition-colors hover:opacity-70">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="mailto:contact@example.com" class="flex items-center gap-2 transition-colors hover:opacity-70">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Email
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
