---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <nav class="hidden lg:block sticky top-24 w-56 shrink-0 ml-12">
    <div class="border-l pl-4" style="border-color: var(--border);">
      <p class="text-[10px] font-semibold uppercase tracking-wider mb-3" style="color: var(--text-muted);">
        目录
      </p>
      <ul class="space-y-2">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class={`block text-sm transition-colors hover:opacity-80 ${heading.depth === 2 ? 'font-medium' : 'pl-3'}`}
              style={`color: ${heading.depth === 2 ? 'var(--text)' : 'var(--text-secondary)'};`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}
