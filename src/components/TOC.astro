---
import dict from '../i18n/dict.js';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: string;
}

const { headings, lang = 'zh' } = Astro.props;
const t = dict[lang] || dict.zh;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <nav class="hidden lg:block sticky top-28 w-64 shrink-0">
    <div class="border-l-2 pl-5" style="border-color: var(--border);">
      <p class="text-xs font-semibold uppercase tracking-wider mb-4" style="color: var(--text-muted);">
        {t['article.toc']}
      </p>
      <ul class="space-y-3">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class={`block text-sm leading-relaxed transition-colors hover:opacity-80 ${heading.depth === 2 ? 'font-medium' : 'pl-3 text-[13px]'}`}
              style={`color: ${heading.depth === 2 ? 'var(--text)' : 'var(--text-secondary)'};`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}
