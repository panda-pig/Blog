---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const posts = await Astro.glob('../content/blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<BaseLayout description="Panda Lab - panda-pig 的个人博客，记录技术学习与项目实践">
  <Header />

  <main class="flex-1">
    <!-- Hero Banner -->
    <section class="hero-banner pt-24 pb-16 sm:pt-28 sm:pb-20 text-white">
      <div class="section-container max-w-5xl relative z-10">
        <div class="flex flex-col lg:flex-row items-start lg:items-center gap-10 lg:gap-16">
          <!-- Left: Title & Intro -->
          <div class="flex-1 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 mb-6 backdrop-blur-sm">
              <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
              <span class="text-sm font-medium">记录技术学习，个人作品集与个人成长</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight mb-6">
              把想法快速
              <span class="underline decoration-4 decoration-[#42a5f5] underline-offset-4">变成产品</span>
            </h1>

            <p class="text-lg text-white/80 leading-relaxed mb-8 max-w-xl">
              我是 panda-pig，一个热爱技术与创造的开发者。在这里分享我的学习笔记、项目实践和思考感悟。
            </p>

            <div class="flex flex-wrap gap-3">
              <a href="/blog" class="material-btn material-btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                阅读文章
              </a>
              <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/10 border border-white/20 text-white text-sm font-medium hover:bg-white/20 transition-all backdrop-blur-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                查看项目
              </a>
            </div>
          </div>

          <!-- Right: Profile Card -->
          <div class="w-full lg:w-auto lg:shrink-0">
            <div class="material-card p-6 sm:p-8 max-w-sm">
              <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl bg-[#2196f3] flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-blue-500/20">
                  P
                </div>
                <div>
                  <h3 class="text-lg font-bold text-[#212121] dark:text-[#f5f5f5]">panda-pig</h3>
                  <p class="text-sm text-[#757575] dark:text-[#9e9e9e]">Developer & Creator</p>
                </div>
              </div>
              
              <p class="text-sm text-[#616161] dark:text-[#bdbdbd] leading-relaxed mb-6">
                专注于 Web 开发与 AI 应用，喜欢将复杂的技术概念转化为简单实用的产品。
              </p>
              
              <div class="flex items-center gap-4 pt-6 border-t border-[#e0e0e0] dark:border-[#333333]">
                <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm text-[#616161] dark:text-[#bdbdbd] hover:text-[#2196f3] dark:hover:text-[#64b5f6] transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
                <a href="/rss.xml" class="flex items-center gap-2 text-sm text-[#616161] dark:text-[#bdbdbd] hover:text-[#2196f3] dark:hover:text-[#64b5f6] transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16"/>
                    <circle cx="5" cy="19" r="1"/>
                  </svg>
                  RSS
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Articles -->
    <section class="py-16 sm:py-20">
      <div class="section-container max-w-5xl">
        <div class="flex items-center justify-between mb-10">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#212121] dark:text-[#f5f5f5] mb-2">精选文章</h2>
            <p class="text-[#757575] dark:text-[#9e9e9e]">分享技术见解与学习心得</p>
          </div>
          <a href="/blog" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-[#2196f3] dark:text-[#64b5f6] hover:text-[#1976d2] dark:hover:text-[#42a5f5] transition-colors group">
            查看全部
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {sortedPosts.slice(0, 4).map((post) => {
            const slug = post.file.split('/').pop().replace('.md', '');
            const readingTime = Math.ceil((post.rawContent?.length || 0) / 400);
            const formattedDate = new Date(post.frontmatter.date).toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            
            return (
              <a href={`/blog/${slug}`} class="material-card block p-6 group">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex flex-wrap gap-2">
                    {post.frontmatter.tags?.slice(0, 2).map((tag) => (
                      <span class="material-chip">{tag}</span>
                    ))}
                  </div>
                  <span class="text-xs text-[#9e9e9e] dark:text-[#757575] font-mono shrink-0">{formattedDate}</span>
                </div>

                <h3 class="text-lg font-semibold text-[#212121] dark:text-[#f5f5f5] mb-2 group-hover:text-[#2196f3] dark:group-hover:text-[#42a5f5] transition-colors line-clamp-2">
                  {post.frontmatter.title}
                </h3>

                <p class="text-sm text-[#616161] dark:text-[#bdbdbd] line-clamp-2 leading-relaxed mb-4">
                  {post.frontmatter.description}
                </p>

                <div class="flex items-center gap-2 text-xs text-[#9e9e9e] dark:text-[#757575]">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                  <span>{readingTime} 分钟阅读</span>
                </div>
              </a>
            );
          })}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#2196f3] dark:text-[#64b5f6] hover:text-[#1976d2] dark:hover:text-[#42a5f5] transition-colors">
            查看全部文章
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 项目预览 -->
    <section class="py-16 sm:py-20 bg-white dark:bg-[#1e1e1e]">
      <div class="section-container max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#212121] dark:text-[#f5f5f5] mb-3">项目展示</h2>
          <p class="text-[#757575] dark:text-[#9e9e9e]">把想法快速变成产品</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="material-card p-6">
            <div class="w-10 h-10 rounded-xl bg-[#2196f3] flex items-center justify-center mb-4 shadow-lg shadow-blue-500/20">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#212121] dark:text-[#f5f5f5] mb-2">JLPT 学习工具</h3>
            <p class="text-sm text-[#616161] dark:text-[#bdbdbd] leading-relaxed mb-4">帮助日语学习者备考 JLPT 的在线工具，包含词汇记忆和模拟测试。</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">React</span>
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">TypeScript</span>
            </div>
          </div>

          <div class="material-card p-6">
            <div class="w-10 h-10 rounded-xl bg-[#42a5f5] flex items-center justify-center mb-4 shadow-lg shadow-blue-400/20">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#212121] dark:text-[#f5f5f5] mb-2">AI 手相分析</h3>
            <p class="text-sm text-[#616161] dark:text-[#bdbdbd] leading-relaxed mb-4">结合计算机视觉的趣味项目，上传照片获取个性分析报告。</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">Python</span>
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">TensorFlow</span>
            </div>
          </div>

          <div class="material-card p-6 md:col-span-2 lg:col-span-1">
            <div class="w-10 h-10 rounded-xl bg-[#1976d2] flex items-center justify-center mb-4 shadow-lg shadow-blue-600/20">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#212121] dark:text-[#f5f5f5] mb-2">Panda Lab 博客</h3>
            <p class="text-sm text-[#616161] dark:text-[#bdbdbd] leading-relaxed mb-4">基于 Astro 构建的个人博客，支持暗色模式和全文搜索。</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">Astro</span>
              <span class="text-[10px] px-2 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#2d2d2d] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333]">Tailwind</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
