---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

const posts = await Astro.glob('../content/blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<BaseLayout>
  <Header />

  <main class="flex-1">
    <section class="pt-16 pb-12 sm:pt-20">
      <div class="max-w-3xl mx-auto px-6">
        <div class="mb-12">
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 dark:text-slate-100 mb-3">
            panda-pig 的博客
          </h1>
          <p class="text-slate-500 dark:text-slate-400 leading-relaxed max-w-lg">
            记录想法、技术和生活碎片。不求每篇都完美，但求真诚记录。
          </p>
        </div>

        <Search />
      </div>
    </section>

    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-sm font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-6">最新文章</h2>

        <div class="space-y-4">
          {sortedPosts.map((post) => {
            const slug = post.file.split('/').pop().replace('.md', '');
            return (
              <a href={`/blog/${slug}`} class="block group p-5 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-mint-200 dark:hover:border-mint-800/50 hover:bg-mint-50/30 dark:hover:bg-mint-900/10 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                  <time class="text-xs text-slate-400 dark:text-slate-500 font-mono shrink-0 w-24">
                    {new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-base font-medium text-slate-800 dark:text-slate-200 group-hover:text-mint-600 dark:group-hover:text-mint-400 transition-colors mb-1">
                      {post.frontmatter.title}
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
                      {post.frontmatter.description}
                    </p>
                    {post.frontmatter.tags && (
                      <div class="flex flex-wrap gap-2 mt-2">
                        {post.frontmatter.tags.map((tag) => (
                          <span class="text-[11px] px-2 py-0.5 rounded-full bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-100 dark:border-slate-700">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {sortedPosts.length === 0 && (
          <p class="text-slate-400 dark:text-slate-500 text-center py-12">还没有文章，开始写作吧！</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
