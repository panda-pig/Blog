---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

const posts = await Astro.glob('./blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<BaseLayout>
  <Header />

  <main class="flex-1">
    <section class="pt-20 pb-16 sm:pt-28 sm:pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="max-w-2xl mx-auto text-center animate-fade-in">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-primary-50 to-accent-50 dark:from-primary-900/20 dark:to-accent-900/20 border border-primary-100 dark:border-primary-800/30 mb-8">
            <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
            <span class="text-sm text-primary-700 dark:text-primary-300 font-medium">记录想法，分享生活</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 dark:text-white mb-6 leading-tight tracking-tight">
            欢迎来到<br/>
            <span class="gradient-text">我的数字花园</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 mb-10 leading-relaxed max-w-lg mx-auto">
            这里存放我的思考、技术和生活碎片。每一个字节都是真实的记录。
          </p>

          <Search />
        </div>
      </div>
    </section>

    <section class="pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">最新文章</h2>
          <a href="/blog" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors flex items-center gap-1">
            查看全部
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid gap-4">
          {sortedPosts.map((post, i) => (
            <a
              href={post.url}
              class={`card p-6 sm:p-7 group block animate-fade-in-delay`}
              style={`animation-delay: ${(i + 1) * 0.1}s`}
            >
              <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-6">
                <time class="text-sm text-slate-400 dark:text-slate-500 font-mono shrink-0 w-24 pt-1">
                  {new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-1">
                    {post.frontmatter.title}
                  </h3>
                  <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-3">
                    {post.frontmatter.description}
                  </p>
                  {post.frontmatter.tags && (
                    <div class="flex flex-wrap gap-1.5">
                      {post.frontmatter.tags.map((tag) => (
                        <span class="text-[11px] px-2.5 py-1 rounded-full bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-100 dark:border-slate-700/50">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="hidden sm:flex items-center self-center opacity-0 group-hover:opacity-100 transition-opacity -translate-x-2 group-hover:translate-x-0">
                  <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-20">
            <div class="w-16 h-16 rounded-2xl bg-slate-50 dark:bg-slate-800/50 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              </svg>
            </div>
            <p class="text-slate-400 dark:text-slate-500">还没有文章，开始写作吧！</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
