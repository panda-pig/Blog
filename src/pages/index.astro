---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

const posts = await Astro.glob('./blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<BaseLayout>
  <Header />
  
  <main class="flex-1">
    <section class="py-16 sm:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100 mb-4">
          欢迎来到我的博客
        </h1>
        <p class="text-lg text-stone-600 dark:text-stone-400 mb-8 max-w-xl mx-auto">
          这里记录我的想法、文章和生活点滴。希望我的分享能给你带来一些启发。
        </p>
        <Search />
      </div>
    </section>
    
    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-8">最新文章</h2>
        
        <div class="space-y-8">
          {sortedPosts.map((post) => (
            <article class="group">
              <a href={post.url} class="block">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                  <time class="text-sm text-stone-400 dark:text-stone-500 shrink-0 w-28">
                    {new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <div>
                    <h3 class="text-lg font-medium text-stone-900 dark:text-stone-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                      {post.frontmatter.title}
                    </h3>
                    <p class="text-sm text-stone-500 dark:text-stone-400 mt-1 line-clamp-2">
                      {post.frontmatter.description}
                    </p>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
        
        {sortedPosts.length === 0 && (
          <p class="text-stone-500 dark:text-stone-400 text-center py-12">
            还没有文章，开始写作吧！
          </p>
        )}
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>
