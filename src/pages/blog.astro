---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

const posts = await Astro.glob('./blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<BaseLayout title="文章列表" description="所有博客文章">
  <Header />
  
  <main class="flex-1">
    <section class="py-12 sm:py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100 mb-8">文章列表</h1>
        <Search />
        
        <div class="mt-12 space-y-8">
          {sortedPosts.map((post) => (
            <article class="group">
              <a href={post.url} class="block">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                  <time class="text-sm text-stone-400 dark:text-stone-500 shrink-0 w-28">
                    {new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <div>
                    <h3 class="text-lg font-medium text-stone-900 dark:text-stone-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                      {post.frontmatter.title}
                    </h3>
                    <p class="text-sm text-stone-500 dark:text-stone-400 mt-1 line-clamp-2">
                      {post.frontmatter.description}
                    </p>
                    {post.frontmatter.tags && (
                      <div class="flex flex-wrap gap-2 mt-2">
                        {post.frontmatter.tags.map((tag: string) => (
                          <span class="text-xs px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-500 dark:text-stone-400">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
        
        {sortedPosts.length === 0 && (
          <p class="text-stone-500 dark:text-stone-400 text-center py-12">
            还没有文章，开始写作吧！
          </p>
        )}
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>
