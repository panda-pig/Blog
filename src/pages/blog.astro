---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import PostCard from '../components/PostCard.astro';

const posts = await Astro.glob('../content/blog/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
const allTags = [...new Set(posts.flatMap(p => p.frontmatter.tags || []))];
---

<BaseLayout title="文章列表" description="Panda Lab 的所有博客文章">
  <Header />

  <main class="flex-1">
    <section class="pt-12 pb-20">
      <div class="section-container max-w-5xl">
        <div class="mb-10">
          <h1 class="text-3xl sm:text-4xl font-bold text-[#212121] dark:text-[#f5f5f5] mb-4">文章列表</h1>
          <p class="text-[#757575] dark:text-[#9e9e9e]">共 {sortedPosts.length} 篇文章，持续更新中</p>
        </div>

        <div class="mb-8 max-w-xl">
          <Search />
        </div>

        {allTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            <span class="material-chip cursor-pointer">
              全部
            </span>
            {allTags.map((tag) => (
              <span class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-[#1e1e1e] text-[#757575] dark:text-[#9e9e9e] border border-[#e0e0e0] dark:border-[#333333] cursor-pointer hover:border-[#2196f3] dark:hover:border-[#2196f3] hover:text-[#2196f3] dark:hover:text-[#64b5f6] transition-colors">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-6">
          {sortedPosts.map((post) => {
            const slug = post.file.split('/').pop().replace('.md', '');
            const readingTime = Math.ceil((post.rawContent?.length || 0) / 400);
            return (
              <PostCard
                title={post.frontmatter.title}
                description={post.frontmatter.description}
                date={post.frontmatter.date}
                tags={post.frontmatter.tags}
                slug={slug}
                readingTime={readingTime}
              />
            );
          })}
        </div>

        {sortedPosts.length === 0 && (
          <div class="text-center py-20">
            <p class="text-[#9e9e9e] dark:text-[#757575]">还没有文章，开始写作吧！</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
