---
import BlogArticlePage from '../../../components/pages/BlogArticlePage.astro';
import { getSlugFromFile } from '../../../lib/posts.js';

export async function getStaticPaths() {
  const allPosts = await Astro.glob('../../../content/blog/*.md');
  const slugs = [...new Set(allPosts.map((post) => post.frontmatter.slug || getSlugFromFile(post.file)))];
  return slugs.map((slug) => ({ params: { slug }, props: { lang: 'en' } }));
}
---

<BlogArticlePage lang="en" />
