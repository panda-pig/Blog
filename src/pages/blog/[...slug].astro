---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Giscus from '../../components/Giscus.astro';
import Donate from '../../components/Donate.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../blog/*.md');
  return posts.map((post) => ({
    params: { slug: post.url?.split('/').pop() || '' },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;
---

<BaseLayout title={post.frontmatter.title} description={post.frontmatter.description}>
  <Header />
  
  <main class="flex-1">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <header class="mb-10">
        <time class="text-sm text-stone-500 dark:text-stone-400 block mb-3">
          {new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100 mb-4">
          {post.frontmatter.title}
        </h1>
        {post.frontmatter.description && (
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed">
            {post.frontmatter.description}
          </p>
        )}
        {post.frontmatter.tags && (
          <div class="flex flex-wrap gap-2 mt-4">
            {post.frontmatter.tags.map((tag: string) => (
              <span class="text-xs px-2.5 py-1 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>
      
      <div class="prose prose-stone dark:prose-invert prose-lg max-w-none">
        <Content />
      </div>
      
      <Donate />
      <Giscus slug={post.url} />
    </article>
  </main>
  
  <Footer />
</BaseLayout>
