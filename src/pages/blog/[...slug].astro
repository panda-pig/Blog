---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Giscus from '../../components/Giscus.astro';
import Donate from '../../components/Donate.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../blog/*.md');
  return posts.map((post) => ({
    params: { slug: post.url?.split('/').pop() || '' },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;

const readingTime = Math.ceil((post.rawContent?.length || 0) / 400);
const formattedDate = new Date(post.frontmatter.date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.frontmatter.title} description={post.frontmatter.description} slug={post.url}>
  <Header />

  <main class="flex-1">
    <article class="max-w-4xl mx-auto px-6 py-16 sm:py-20">
      <header class="mb-12 animate-fade-in">
        <div class="flex items-center gap-3 mb-8">
          <a href="/blog" class="text-sm text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 19l-7-7 7-7"/>
            </svg>
            返回列表
          </a>
        </div>

        <time class="text-sm text-slate-400 dark:text-slate-500 font-mono mb-4 block">
          {formattedDate}
        </time>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight tracking-tight">
          {post.frontmatter.title}
        </h1>

        {post.frontmatter.description && (
          <p class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 leading-relaxed mb-6 max-w-2xl">
            {post.frontmatter.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 dark:text-slate-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            阅读约 {readingTime} 分钟
          </span>
          {post.frontmatter.tags && (
            <div class="flex flex-wrap gap-2">
              {post.frontmatter.tags.map((tag) => (
                <span class="text-xs px-3 py-1 rounded-full bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-100 dark:border-slate-700/50">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none animate-fade-in-delay">
        <Content />
      </div>

      <Donate />
      <Giscus slug={post.url} />
    </article>
  </main>

  <Footer />
</BaseLayout>
