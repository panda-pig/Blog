---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 · Panda Blog" description="页面不存在" lang="zh">
  <Header lang="zh" />

  <main class="section-container flex flex-col items-center justify-center text-center" style="min-height: calc(100vh - 144px); padding-top: 4rem; padding-bottom: 6rem;">

    <!-- 数字装饰 -->
    <div class="relative mb-8 select-none" aria-hidden="true">
      <span class="font-serif font-bold leading-none" style="font-size: clamp(6rem, 20vw, 10rem); color: var(--primary-light); letter-spacing: -0.04em;">404</span>
      <span class="absolute inset-0 flex items-center justify-center font-serif font-bold leading-none" style="font-size: clamp(6rem, 20vw, 10rem); color: var(--primary); opacity: 0.18; letter-spacing: -0.04em; transform: translate(3px, 3px);">404</span>
    </div>

    <!-- 文字 -->
    <h1 class="font-serif text-2xl md:text-3xl font-semibold mb-3" style="color: var(--text); letter-spacing: -0.01em;">
      页面不见了
    </h1>
    <p class="text-sm md:text-base mb-1" style="color: var(--text-secondary); max-width: 28rem; line-height: 1.75;">
      你访问的页面可能已经被移动、删除，或者从未存在过。
    </p>
    <p class="text-xs mb-10" style="color: var(--text-muted);">
      Page not found · ページが見つかりません
    </p>

    <!-- 按钮 -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">
        返回首页
      </a>
      <a href="/blog" class="btn-secondary">
        浏览文章
      </a>
    </div>

    <!-- 装饰线 -->
    <div class="mt-16 flex items-center gap-3" style="color: var(--text-muted);">
      <div class="h-px w-10 rounded-full" style="background: var(--border);"></div>
      <span class="text-xs font-mono tracking-wider">panda-blog.com</span>
      <div class="h-px w-10 rounded-full" style="background: var(--border);"></div>
    </div>

  </main>

  <Footer lang="zh" />
</BaseLayout>
