---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
---

<BaseLayout title="关于我" description="关于 panda-pig 和 Panda Lab">
  <div id="page" class="flex min-h-screen md:mx-10 md:mt-14">
    <Sidebar />

    <!-- Main Content -->
    <main class="w-full flex-1 rounded-r-md pb-20" style="background-color: var(--content-bg);">
      <!-- Mobile Header -->
      <div class="relative md:hidden">
        <div class="absolute right-4 top-5 z-10">
          <DarkModeToggle />
        </div>
      </div>

      <div class="px-4 md:px-10 pt-10">
        <h1 class="text-3xl sm:text-4xl font-bold mb-8" style="color: var(--title);">关于我</h1>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-lg leading-relaxed mb-6" style="color: var(--text-secondary);">
            你好，我是 panda-pig，一个热爱技术与创造的开发者。我相信好的产品是技术与设计的完美结合，而持续学习是成长的唯一路径。
          </p>
          
          <h2 class="text-xl font-semibold mt-10 mb-4" style="color: var(--title);">我在做什么</h2>
          <p class="mb-5 leading-7" style="color: var(--text);">
            目前专注于 Web 开发和 AI 应用。我喜欢探索新技术，并将其应用到实际项目中。Panda Lab 是我记录学习和分享成果的地方。
          </p>
          
          <h2 class="text-xl font-semibold mt-10 mb-4" style="color: var(--title);">技术栈</h2>
          <ul class="mb-5 pl-5" style="color: var(--text);">
            <li class="mb-2"><strong style="color: var(--title);">前端：</strong>React, Next.js, Astro, Tailwind CSS, TypeScript</li>
            <li class="mb-2"><strong style="color: var(--title);">后端：</strong>Node.js, Python, PostgreSQL</li>
            <li class="mb-2"><strong style="color: var(--title);">AI/ML：</strong>TensorFlow, PyTorch, OpenAI API</li>
            <li class="mb-2"><strong style="color: var(--title);">工具：</strong>Git, Docker, Vercel, Figma</li>
          </ul>
          
          <h2 class="text-xl font-semibold mt-10 mb-4" style="color: var(--title);">联系我</h2>
          <p class="mb-5 leading-7" style="color: var(--text);">
            如果你有任何问题或合作意向，欢迎通过以下方式联系我：
          </p>
          <ul class="mb-5 pl-5" style="color: var(--text);">
            <li class="mb-2">GitHub: <a href="https://github.com/panda-pig" target="_blank" rel="noopener noreferrer">github.com/panda-pig</a></li>
            <li class="mb-2">Email: <a href="mailto:contact@example.com">contact@example.com</a></li>
          </ul>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
