---
import '../styles/global.css';

const { title, description, slug } = Astro.props;
const siteTitle = title ? title : 'Panda Lab';
const canonicalUrl = `https://blog-beta-kohl-92.vercel.app${slug || ''}`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description || 'panda-pig 的个人博客'} />
    <meta name="author" content="panda-pig" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description || 'panda-pig 的个人博客'} />

    <script defer data-domain="blog-beta-kohl-92.vercel.app" src="https://plausible.io/js/script.js"></script>

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen" data-pagefind-body>
    <slot />
    <script is:inline type="module">
      import dict from '/i18n/dict.js';
      function apply() {
        const lang = localStorage.getItem('lang') || 'zh';
        const t = dict[lang] || dict.zh;
        const year = new Date().getFullYear();
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (t[key]) {
            el.textContent = t[key].replace(/\{year\}/g, year);
          }
        });
        document.querySelectorAll('[data-i18n-html]').forEach(el => {
          const key = el.getAttribute('data-i18n-html');
          if (t[key]) {
            el.innerHTML = t[key].replace(/\{year\}/g, year);
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (t[key]) {
            el.setAttribute('placeholder', t[key].replace(/\{year\}/g, year));
          }
        });
      }
      apply();
      document.addEventListener('astro:after-swap', apply);
    </script>
  </body>
</html>
