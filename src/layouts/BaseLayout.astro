---
import '../styles/global.css';
import dict from '../i18n/dict.js';
import { ViewTransitions } from 'astro:transitions';

const { title, description, slug, lang = 'zh' } = Astro.props;
const siteTitle = title ? title : 'Panda Blog';
const siteUrl = 'https://panda-blog.com';
const canonicalUrl = `${siteUrl}${slug || ''}`;
const htmlLang = lang === 'zh' ? 'zh-CN' : lang;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description || 'panda 的个人博客'} />
    <meta name="author" content="panda" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{siteTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description || 'panda 的个人博客'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/images/avatar.jpg`} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`${siteUrl}/images/avatar.jpg`} />

    <script defer data-domain="panda-blog.com" src="https://plausible.io/js/script.js"></script>

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script is:inline define:vars={{ i18nJSON: JSON.stringify(dict) }}>
      window.i18nDict = JSON.parse(i18nJSON);
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
